+}
+
+string BEJournalPath(ulong pid)
+{ return TradeMetaPath(pid)+".be.journal"; }
+
+uint BEChecksum(string text)
+{
+  uint value=2166136261;
+  for(int i=0;i<StringLen(text);i++)
+    value=(value^(uint)StringGetCharacter(text,i))*16777619;
+  return value;
+}
+
+string BEJournalRow(ulong pid,const BreakEvenState &b)
+{
+   string row="SCALPER1995_PR2|"+(string)AccountInfoInteger(ACCOUNT_LOGIN)+"|"+
+      RJEncode(Symbol())+"|"+(string)gMagicCore+"|"+(string)pid+"|"+
+      (string)b.stage+"|"+(string)b.ticket+"|"+(b.direction==1?"BUY":"SELL")+"|"+
+      DoubleToString(b.entryPrice,16)+"|"+DoubleToString(b.initialSL,16)+"|"+
+      DoubleToString(b.price,16)+"|"+DoubleToString(b.tp,16)+"|"+
+      (string)b.triggerMSC+"|"+(string)b.confirmedMSC+"|"+
+      (string)b.requestID+"|"+(string)b.retcode+"|"+
+      (string)b.exitMode+"|"+(string)b.targetLevel+"|"+
+      (string)(b.confirmedLevel+1)+"|"+DoubleToString(b.confirmedPrice,16)+"|"+
+      (string)b.confirmedAt;
+   return row+"|"+(string)BEChecksum(row)+"|COMPLETE_PR2";
+}
+
+
+bool BEParseRow(string row,ulong pid,BreakEvenState &b)
+{
+   string f[],symbol;
+   ulong account,magic,parsedPID,stage,ticket,trigger,confirmed,requestID,retcode,
+         exitMode,targetLevel,confirmedPlusOne,confirmedAt,checksum;
+   if(StringSplit(row,'|',f)!=23 || f[0]!="SCALPER1995_PR2" || f[22]!="COMPLETE_PR2" ||
+      !RJUnsigned(f[1],account) || account!=(ulong)AccountInfoInteger(ACCOUNT_LOGIN) ||
+      !RJDecode(f[2],symbol) || symbol!=Symbol() ||
+      !RJUnsigned(f[3],magic) || magic!=(ulong)gMagicCore ||
+      !RJUnsigned(f[4],parsedPID) || parsedPID!=pid || pid==0 ||
+      !RJUnsigned(f[5],stage) || stage<BE_TRIGGERED || stage>BE_CONFIRMED ||
+      !RJUnsigned(f[6],ticket) || ticket==0 || (f[7]!="BUY" && f[7]!="SELL") ||
+      !RJUnsigned(f[12],trigger) || trigger==0 || trigger>9223372036854775807 ||
+      !RJUnsigned(f[13],confirmed) || confirmed>9223372036854775807 ||
+      !RJUnsigned(f[14],requestID) || requestID>4294967295 ||
+      !RJUnsigned(f[15],retcode) || retcode>4294967295 ||
+      !RJUnsigned(f[16],exitMode) || exitMode>(ulong)PROGRESSIVE_NO_TP ||
+      !RJUnsigned(f[17],targetLevel) || targetLevel>5 ||
+      !RJUnsigned(f[18],confirmedPlusOne) || confirmedPlusOne>6 ||
+      !RJUnsigned(f[20],confirmedAt) || confirmedAt>9223372036854775807 ||
+      !RJUnsigned(f[21],checksum) || checksum>4294967295) return false;
+   string prefix=f[0]; for(int i=1;i<21;i++) prefix+="|"+f[i];
+   if(BEChecksum(prefix)!=(uint)checksum) return false;
+   ZeroMemory(b);
+   if(!RJDouble(f[8],b.entryPrice) || !RJDouble(f[9],b.initialSL) ||
+      !RJDouble(f[10],b.price) || !RJDouble(f[11],b.tp) ||
+      !RJDouble(f[19],b.confirmedPrice) || !Positive(b.entryPrice) ||
+      !Positive(b.initialSL) || !Positive(b.price)) return false;
+   b.stage=(int)stage; b.ticket=ticket; b.direction=(f[7]=="BUY"?1:-1);
+   b.triggerMSC=(long)trigger; b.confirmedMSC=(long)confirmed;
+   b.requestID=(uint)requestID; b.retcode=(uint)retcode;
+   b.exitMode=(int)exitMode; b.targetLevel=(int)targetLevel;
+   b.confirmedLevel=(int)confirmedPlusOne-1; b.confirmedAt=(long)confirmedAt;
+   bool progressive=(b.exitMode==(int)PROGRESSIVE_NO_TP);
+   if(b.direction*(b.entryPrice-b.initialSL)<=0 || b.confirmedLevel>b.targetLevel ||
+      (!progressive && b.targetLevel!=0) || (progressive && b.tp!=0) ||
+      !BEPriceEqual(b.price,ProtectionPrice(b.direction,b.entryPrice,b.initialSL,b.targetLevel,progressive)) ||
+      (b.confirmedLevel<0 && (b.confirmedAt!=0 || b.confirmedPrice!=0)) ||
+      (b.confirmedLevel>=0 && (b.confirmedAt==0 || !BEPriceEqual(b.confirmedPrice,
+         ProtectionPrice(b.direction,b.entryPrice,b.initialSL,b.confirmedLevel,progressive)))) ||
+      (b.stage>=BE_ACKNOWLEDGED && (b.retcode!=TRADE_RETCODE_DONE || b.requestID==0 ||
+         b.confirmedMSC<b.triggerMSC)) ||
+      (b.stage==BE_CONFIRMED && (b.confirmedLevel!=b.targetLevel ||
+         b.confirmedAt!=b.confirmedMSC))) return false;
+   b.durable=true;
+   return true;
+}
+
+bool ProtectionStateFollows(const BreakEvenState &previous,const BreakEvenState &next)
+{
+   // Reject rewritten references or a replay/downgrade inside a valid-checksum journal.
+   return previous.direction==next.direction && previous.exitMode==next.exitMode &&
+      BEPriceEqual(previous.entryPrice,next.entryPrice) &&
+      BEPriceEqual(previous.initialSL,next.initialSL) &&
+      next.confirmedLevel>=previous.confirmedLevel &&
+      next.targetLevel>=previous.targetLevel &&
+      next.triggerMSC>=previous.triggerMSC && next.confirmedAt>=previous.confirmedAt;
+}
+
+
+bool BEReadJournal(ulong pid,BreakEvenState &b,bool &exists)
+{
+   exists=FileIsExist(BEJournalPath(pid));
+   if(!exists) return false;
+   int h=FileOpen(BEJournalPath(pid),FILE_READ|FILE_BIN|FILE_SHARE_READ);
+   if(h==INVALID_HANDLE) return false;
+   ResetLastError(); ulong size=FileSize(h);
+   bool found=false,ok=(GetLastError()==0 && size>0 && size<=1048576);
+   uchar bytes[4096]; ulong offset=0; string row=""; bool cr=false;
+   while(ok && offset<size)
+   {
+      int want=(size-offset>4096)?4096:(int)(size-offset);
+      ResetLastError(); uint got=FileReadArray(h,bytes,0,want);
+      if(got!=(uint)want || GetLastError()!=0) { ok=false; break; }
+      offset+=got;
+      for(int i=0;i<want;i++)
+      {
+         uchar value=bytes[i];
+         if(value==10 && cr)
+         {
+            if(row!="")
+            {
+               BreakEvenState candidate;
+               if(!BEParseRow(row,pid,candidate) ||
+                  (found && !ProtectionStateFollows(b,candidate))) { ok=false; break; }
+               b=candidate; found=true;
+            }
+            row=""; cr=false; continue;
+         }
+         if(cr) { ok=false; break; }
+         if(value==13) { cr=true; continue; }
+         if(value<32 || value>126 || StringLen(row)>=32768) { ok=false; break; }
+         row+=ShortToString((ushort)value);
+      }
+   }
+   // Even a complete-looking payload without its final CRLF is a torn write.
+   if(row!="" || cr || !found) ok=false;
+   ResetLastError(); ulong finalSize=FileSize(h);
+   if(GetLastError()!=0 || finalSize!=size) ok=false;
+   ResetLastError(); FileClose(h);
+   if(GetLastError()!=0) ok=false;
+   // Never fall back over a torn pending tail to an older confirmed certificate.
+   return found && ok;
+}
+
+
+bool BEPersist(TradeRecord &r)
+{
+  string row=BEJournalRow(r.positionID,r.be),payload="\r\n"+row+"\r\n";
+  int h=FileOpen(BEJournalPath(r.positionID),
+     FILE_READ|FILE_WRITE|FILE_TXT|FILE_ANSI|FILE_SHARE_READ);
+  bool ok=false;
+  if(h!=INVALID_HANDLE)
+  {
+     if(FileSeek(h,0,SEEK_END))
+     {
+        ResetLastError(); uint written=FileWriteString(h,payload);
+        ok=(written==(uint)StringLen(payload) && GetLastError()==0);
+        ResetLastError(); FileFlush(h); if(GetLastError()!=0) ok=false;
+     }
+     FileClose(h);
+    }
+    BreakEvenState verified; bool exists=false;
+    if(ok) ok=BEReadJournal(r.positionID,verified,exists) &&
+       BEJournalRow(r.positionID,verified)==row;
+    r.be.durable=ok;
+    if(!ok) BEFailure(r,"BE_PERSISTENCE_UNCONFIRMED; no durable activation claimed");
+    return ok;
+}
+
+void BELoad(TradeRecord &r)
+{
+  BreakEvenState loaded; bool exists=false;
+  if(BEReadJournal(r.positionID,loaded,exists)) r.be=loaded;
+  else if(exists)
+  {
+     r.be.stage=BE_UNRESOLVED;
+     BELog(r,"BE_PROOF_UNAVAILABLE","Unreadable/corrupt journal; no inferred BE");
+  }
+}
+
+bool BESelectOwn(ulong pid,ulong &ticket,int direction)
+{
+  for(int i=PositionsTotal()-1;i>=0;i--)
+  {
+    ulong candidate=PositionGetTicket(i);
+    if(candidate==0 || !PositionSelectByTicket(candidate) ||
+       PositionGetString(POSITION_SYMBOL)!=Symbol() ||
+       PositionGetInteger(POSITION_MAGIC)!=(long)gMagicCore ||
+       (ulong)PositionGetInteger(POSITION_IDENTIFIER)!=pid ||
+       (PositionGetInteger(POSITION_TYPE)==POSITION_TYPE_BUY?1:-1)!=direction)
+continue;
+    ticket=candidate; return true;
+  }
+  return false;
+}
+
+bool BEEntryComplete(const TradeRecord &r)
+{
+  if(r.entryOrderTicket==0 || OrderSelect(r.entryOrderTicket) ||
+     !HistoryOrderSelect(r.entryOrderTicket) ||
+     HistoryOrderGetString(r.entryOrderTicket,ORDER_SYMBOL)!=Symbol() ||
+     HistoryOrderGetInteger(r.entryOrderTicket,ORDER_MAGIC)!=(long)gMagicCore ||
+     (ulong)HistoryOrderGetInteger(r.entryOrderTicket,ORDER_POSITION_ID)!=r.positionID)
+     return false;
+  ENUM_ORDER_STATE
+state=(ENUM_ORDER_STATE)HistoryOrderGetInteger(r.entryOrderTicket,ORDER_STATE);
+  if(state!=ORDER_STATE_FILLED && state!=ORDER_STATE_CANCELED &&
+     state!=ORDER_STATE_REJECTED && state!=ORDER_STATE_EXPIRED) return false;
+    double filled=HistoryOrderGetDouble(r.entryOrderTicket,ORDER_VOLUME_INITIAL)-
+      HistoryOrderGetDouble(r.entryOrderTicket,ORDER_VOLUME_CURRENT);
+    return filled>0 && MathAbs(filled-r.totalVolumeIn)<=AccountingVolumeTolerance();
+}
+
+bool BEStopsValid(const TradeRecord &r,const MqlTick &tick,double liveSL,double liveTP)
+{
+  double size=SymbolInfoDouble(Symbol(),SYMBOL_TRADE_TICK_SIZE);
+  double point=SymbolInfoDouble(Symbol(),SYMBOL_POINT);
+  if(!Positive(size) || !Positive(point) || MathAbs(size-gTickSize)>size*0.000001 ||
+     !Positive(tick.bid) || !Positive(tick.ask) || tick.ask<tick.bid ||
+     !OnPriceGrid(r.be.price) || !Positive(liveSL) ||
+     r.direction*(r.be.price-liveSL)<=size*0.000001) return false;
+  long stops=SymbolInfoInteger(Symbol(),SYMBOL_TRADE_STOPS_LEVEL);
+  long freeze=SymbolInfoInteger(Symbol(),SYMBOL_TRADE_FREEZE_LEVEL);
+  if(stops<0 || freeze<0) return false;
+  double quote=(r.direction==1?tick.bid:tick.ask);
+  double stopDistance=r.direction*(quote-r.be.price);
+  double oldDistance=r.direction*(quote-liveSL);
+  if(stopDistance<=0 || stopDistance+size*0.000001<stops*point ||
+     (freeze>0 && (stopDistance<=freeze*point || oldDistance<=freeze*point))) return false;
+  if(liveTP!=0)
+  {
+     double tpDistance=r.direction*(liveTP-quote);
+     if(!OnPriceGrid(liveTP) || tpDistance<=0 || tpDistance+size*0.000001<stops*point ||
+        (freeze>0 && tpDistance<=freeze*point)) return false;
+  }
+  return true;
+}
+
+// A historical certificate belongs to an actual confirmed stop, independently
+// of a newer request's stage, target, retcode or durability flag in RAM.
+bool BEExitAtProtectedLevel(const TradeRecord &r,ulong deal,const BreakEvenState &proof)
+{
+   return r.initialStopsProven && r.riskValid && r.accountingResolved &&
+      r.direction==proof.direction && BEPriceEqual(r.weightedEntryPrice,proof.entryPrice) &&
+      BEPriceEqual(r.slPrice,proof.initialSL) &&
+      HistoryDealGetString(deal,DEAL_SYMBOL)==Symbol() &&
+      (ulong)HistoryDealGetInteger(deal,DEAL_POSITION_ID)==r.positionID &&
+      HistoryDealGetInteger(deal,DEAL_ENTRY)==DEAL_ENTRY_OUT &&
+      HistoryDealGetInteger(deal,DEAL_REASON)==DEAL_REASON_SL &&
+      HistoryDealGetInteger(deal,DEAL_TIME_MSC)>=proof.confirmedAt &&
+      BEPriceEqual(HistoryDealGetDouble(deal,DEAL_SL),proof.confirmedPrice);
+}
+
+// This predicate is ONLY for confirming the latest acknowledged modification.
+// Matching an older certified stop must never confirm a newer pending target.
+bool BERequestedExitAtTarget(const TradeRecord &r,ulong deal)
+{
+   return BEReferenceValid(r) &&
+      HistoryDealGetString(deal,DEAL_SYMBOL)==Symbol() &&
+      (ulong)HistoryDealGetInteger(deal,DEAL_POSITION_ID)==r.positionID &&
+      HistoryDealGetInteger(deal,DEAL_ENTRY)==DEAL_ENTRY_OUT &&
+      HistoryDealGetInteger(deal,DEAL_REASON)==DEAL_REASON_SL &&
+      HistoryDealGetInteger(deal,DEAL_TIME_MSC)>=r.be.confirmedMSC &&
+      HistoryDealGetInteger(deal,DEAL_TIME_MSC)>=r.be.triggerMSC &&
+      BEPriceEqual(HistoryDealGetDouble(deal,DEAL_SL),r.be.price);
+}
+
+
+bool BEProtectedDeal(const TradeRecord &r,ulong deal,const BreakEvenState &proof)
+{
+   return proof.stage==BE_CONFIRMED && proof.durable &&
+      proof.retcode==TRADE_RETCODE_DONE && proof.requestID>0 &&
+      proof.confirmedLevel>=0 && proof.confirmedLevel==proof.targetLevel &&
+      proof.confirmedAt>0 && proof.confirmedAt==proof.confirmedMSC &&
+      proof.confirmedAt>=proof.triggerMSC &&
+      BEPriceEqual(proof.confirmedPrice,proof.price) &&
+      BEExitAtProtectedLevel(r,deal,proof);
+}
+
+// Existing PR2 schema is retained. Read historical CONFIRMED rows as bounded
+// certificates (at most six levels), never replace the live pending request.
+bool BEReadProtectionCertificates(const TradeRecord &r,BreakEvenState &certificates[])
+{
+   ArrayResize(certificates,0);
+   BreakEvenState latest; bool exists=false;
+   if(!BEReadJournal(r.positionID,latest,exists)) return false;
+   int h=FileOpen(BEJournalPath(r.positionID),FILE_READ|FILE_TXT|FILE_ANSI|FILE_SHARE_READ);
+   if(h==INVALID_HANDLE) return false;
+   ResetLastError(); ulong size=FileSize(h);
+   bool ok=(GetLastError()==0 && size>0 && size<=1048576),found=false;
+   BreakEvenState previous = {};
+   while(ok && !FileIsEnding(h))
+   {
+      ResetLastError(); string row=FileReadString(h);
+      if(GetLastError()!=0) { ok=false; break; }
+      if(row=="") continue;
+      BreakEvenState candidate;
+      if(!BEParseRow(row,r.positionID,candidate) ||
+         (found && !ProtectionStateFollows(previous,candidate))) { ok=false; break; }
+      previous=candidate; found=true;
+      if(candidate.stage!=BE_CONFIRMED) continue;
+      int n=ArraySize(certificates);
+      if(n>0 && certificates[n-1].confirmedLevel==candidate.confirmedLevel)
+      { continue; } // retain earliest confirmation time for earlier partial exits
+      if(n>=6 || ArrayResize(certificates,n+1)!=n+1) { ok=false; break; }
+      certificates[n]=candidate;
+   }
+   ResetLastError(); ulong finalSize=FileSize(h);
+   if(GetLastError()!=0 || finalSize!=size) ok=false;
+   ResetLastError(); FileClose(h);
+   if(GetLastError()!=0 || !found) ok=false;
+   if(ok && BEJournalRow(r.positionID,previous)!=BEJournalRow(r.positionID,latest)) ok=false;
+   if(!ok) ArrayResize(certificates,0);
+   // A corrupt/torn journal never creates a certificate or authorizes dispatch.
+   return ok;
+}
+
+
+bool BEConfirm(TradeRecord &r,ulong protectedExitDeal=0)
+{
+   if(r.be.stage==BE_CONFIRMED) return r.be.durable && BEReferenceValid(r);
+   if(r.be.stage!=BE_ACKNOWLEDGED || r.be.retcode!=TRADE_RETCODE_DONE ||
+      !BEReferenceValid(r)) return false;
+   if(!r.be.durable && !BEPersist(r)) return false;
+   ulong ticket=0;
+   bool live=BESelectOwn(r.positionID,ticket,r.direction) &&
+      BEPriceEqual(PositionGetDouble(POSITION_SL),r.be.price) &&
+      PositionGetDouble(POSITION_TP)==r.be.tp;
+   bool protectedExit=(protectedExitDeal>0 && BERequestedExitAtTarget(r,protectedExitDeal));
+   if(!live && !protectedExit) return false;
+   BreakEvenState before=r.be;
+   r.be.stage=BE_CONFIRMED; r.be.confirmedLevel=r.be.targetLevel;
+   r.be.confirmedPrice=r.be.price; r.be.confirmedAt=r.be.confirmedMSC;
+   if(!BEPersist(r)) { r.be=before; r.be.durable=false; return false; }
+   if(!r.be.successLogged)
+   { BELog(r,"PROTECTION_CONFIRMED","level="+(string)r.be.confirmedLevel); r.be.successLogged=true; }
+   return true;
+}
+
+// Classification is read-only with respect to a newer pending modification.
+// Net economics and the original BE-neutral loss-counter rule remain unchanged.
+void ClassifyProtectionExits(TradeRecord &r,ulong &deals[],int count,bool listValid)
+{
+   r.breakEvenExit=false; r.breakEvenClassificationPending=false;
+   if(r.be.stage==BE_NONE) return;
+   if(!listValid || count<=0)
+   { r.breakEvenClassificationPending=r.volumeClosedComplete && !listValid; return; }
+   // Only an acknowledged target with its own exact exit evidence may be promoted.
+   for(int i=0;i<count && r.be.stage==BE_ACKNOWLEDGED;i++)
+      if(BERequestedExitAtTarget(r,deals[i])) BEConfirm(r,deals[i]);
+   BreakEvenState certificates[];
+   if(!BEReadProtectionCertificates(r,certificates))
+   {
+      r.breakEvenClassificationPending=r.volumeClosedComplete;
+      BEFailure(r,"PROTECTION_EXIT_CERTIFICATE_UNAVAILABLE; reconciliation required");
+      return;
+   }
+   bool allCertified=true,allZero=true,anyPositive=false,awaitingTarget=false;
+   for(int i=0;i<count;i++)
+   {
+      int level=-1;
+      for(int j=0;j<ArraySize(certificates);j++)
+         if(BEProtectedDeal(r,deals[i],certificates[j]))
+         { level=certificates[j].confirmedLevel; break; }
+      if(level<0)
+      {
+         allCertified=false; allZero=false;
+         if(BERequestedExitAtTarget(r,deals[i]) &&
+            (r.be.stage==BE_REQUEST_PENDING || r.be.stage==BE_ACKNOWLEDGED))
+            awaitingTarget=true;
+      }
+      else { if(level!=0) allZero=false; if(level>0) anyPositive=true; }
+   }
+   r.breakEvenClassificationPending=r.volumeClosedComplete && awaitingTarget;
+   if(r.breakEvenClassificationPending)
+      BEFailure(r,"PROTECTION_EXIT_PROOF_PENDING; finalization/accounting publication deferred");
+   r.breakEvenExit=allCertified && allZero && r.volumeClosedComplete && r.accountingResolved;
+   if(r.breakEvenExit)
+   {
+      r.exitReason="BE";
+      if(!r.be.exitLogged)
+      { BELog(r,"BE_EXIT","certified level=0; net economics unchanged"); r.be.exitLogged=true; }
+   }
+   else if(allCertified && anyPositive && r.volumeClosedComplete && r.accountingResolved)
+   {
+      // Includes mixed certified 0R/+R partial exits; never BE-neutral as a whole.
+      r.exitReason="PROFIT_LOCK";
+      if(!r.be.exitLogged)
+      { BELog(r,"PROFIT_LOCK_EXIT","certified stop levels; actual net PnL and costs retained"); r.be.exitLogged=true; }
+   }
+}
