+
+bool SendOrder(int direction, double unusedLots, string mode,
+       double slPts, double tpPts,
+       double posRel, double distD1, double effort, double trigger)
+{
+  string dStr=DirStr(direction);
+  // Defense against an uninitialized/changed account mode. Unsupported modes
+  // are already rejected explicitly by OnInit, before financial recovery or IO.
+  if(!OperationalAccountModeSupported())
+  { WriteAuditRow("ACCOUNT_MODE_UNSUPPORTED_OR_CHANGED",dStr,mode,0,posRel,distD1,effort,trigger); return false; }
+  if(!armed.active || mode!=armed.mode || direction!=armed.dir) return false;
+  if(HasOpenPosition())
+  { WriteAuditRow("LATE_POSITION_BLOCK",dStr,mode,0,posRel,distD1,effort,trigger);
+return false; }
+ if(ordersEnteredToday>=Inp_MaxTradesDay)
+ { WriteAuditRow("LATE_QUOTA_BLOCK",dStr,mode,0,posRel,distD1,effort,trigger); return
+false; }
+ if(dailyRiskBlocked || gAccountingUnresolved)
+ { WriteAuditRow("LATE_DAILY_RISK_BLOCK",dStr,mode,0,posRel,distD1,effort,trigger);
+return false; }
+ if(HasExecutionInFlight())
+ { WriteAuditRow("LATE_PENDING_BLOCK",dStr,mode,0,posRel,distD1,effort,trigger);
+return false; }
+
+   // FAR history work finishes BEFORE the final executable quote and any
+   // persisted financial preparation; a veto never erases financial proof.
+   if(FARBeforeDecision()) return false;
+   // One final snapshot: all risk/stops calculations refer to this executable quote.
+   MqlTick finalTick;
+   if(!SymbolInfoTick(Symbol(),finalTick) || finalTick.ask<=0 || finalTick.bid<=0 ||
+      finalTick.ask<finalTick.bid) return false;
+   if(!EntryDispatchGuard(finalTick)) return false;
+   double finalExec=(direction==1)?finalTick.ask:finalTick.bid;
+   if(finalTick.ask-finalTick.bid>gSpreadMaxPts) return false;
+   bool finalBreakout=(direction==1)?finalExec>=trigger:finalExec<=trigger;
+   if(!finalBreakout)
+   {
+WriteAuditRow("LATE_BREAKOUT_LOST",dStr,mode,finalExec,posRel,distD1,effort,trigger)
+; return false; }
+   double over=(direction==1)?finalExec-trigger:trigger-finalExec;
+   if(over>gMaxOvershoot)
+   {
+WriteAuditRow("LATE_OVERSHOOT_BLOCK",dStr,mode,finalExec,posRel,distD1,effort,trigger); return false; }
+  double sl=NormEntrySL(direction,finalExec-direction*slPts);
+  double tp=(Inp_ExitMode==PROGRESSIVE_NO_TP)?0.0:NormEntryTP(direction,finalExec+direction*tpPts);
+  if(sl<=0 || !EntryTPValid(tp)) return false;
+  double minDist=(double)SymbolInfoInteger(Symbol(),SYMBOL_TRADE_STOPS_LEVEL)*
+      SymbolInfoDouble(Symbol(),SYMBOL_POINT);
+  // Server stops are also measured from the closing quote (bid for buy, ask for sell).
+  double closingQuote=(direction==1)?finalTick.bid:finalTick.ask;
+  if(direction*(finalExec-sl)<minDist || (tp>0 && direction*(tp-finalExec)<minDist) ||
+     direction*(closingQuote-sl)<minDist || (tp>0 && direction*(tp-closingQuote)<minDist))
+  {
+WriteAuditRow("STOPS_LEVEL_BLOCK",dStr,mode,finalExec,posRel,distD1,effort,trigger);
+return false; }
+  double lots=ComputeLotsForEntry(direction,finalExec,sl);
+  if(lots<=0) return false;
+  ENUM_ORDER_TYPE type=(direction==1)?ORDER_TYPE_BUY:ORDER_TYPE_SELL;
+  double margin=0;
+  if(!OrderCalcMargin(type,Symbol(),lots,finalExec,margin) ||
+     !MathIsValidNumber(margin) || margin<0 ||
+     AccountInfoDouble(ACCOUNT_MARGIN_FREE)<margin)
+  { WriteAuditRow("NO_MARGIN",dStr,mode,finalExec,posRel,distD1,effort,trigger); return
+false; }
+   trade.SetExpertMagicNumber(gMagicCore);
+   trade.SetTypeFilling(ORDER_FILLING_FOK);
+   // Re-read immediately before dispatch. A moved executable quote needs fresh
+   // sizing/stops; a changed closing quote always needs a fresh STOPS_LEVEL check.
+   MqlTick dispatchTick;
+   if(!SymbolInfoTick(Symbol(),dispatchTick)) return false;
+   if(!EntryDispatchGuard(dispatchTick)) return false;
+   double dispatchExec=(direction==1)?dispatchTick.ask:dispatchTick.bid;
+   if(dispatchExec<=0 || dispatchTick.ask<=0 || dispatchTick.bid<=0 ||
+      dispatchTick.ask<dispatchTick.bid || dispatchTick.ask-dispatchTick.bid>gSpreadMaxPts)
+return false;
+   if((direction==1 && dispatchExec<trigger) || (direction==-1 && dispatchExec>trigger))
+   {
+WriteAuditRow("LATE_BREAKOUT_LOST",dStr,mode,dispatchExec,posRel,distD1,effort,trigger); return false; }
+   if(direction*(dispatchExec-trigger)>gMaxOvershoot)
+   {
+WriteAuditRow("LATE_OVERSHOOT_BLOCK",dStr,mode,dispatchExec,posRel,distD1,effort,trigger); return false; }
+   if(dispatchExec!=finalExec)
+   {
+      finalExec=dispatchExec;
+      sl=NormEntrySL(direction,finalExec-direction*slPts);
+      tp=(Inp_ExitMode==PROGRESSIVE_NO_TP)?0.0:NormEntryTP(direction,finalExec+direction*tpPts);
+      lots=ComputeLotsForEntry(direction,finalExec,sl);
+      closingQuote=(direction==1)?dispatchTick.bid:dispatchTick.ask;
+      if(sl<=0 || !EntryTPValid(tp) || lots<=0 || direction*(closingQuote-sl)<minDist ||
+     (tp>0 && direction*(tp-closingQuote)<minDist))
+      {
+WriteAuditRow("STOPS_LEVEL_BLOCK",dStr,mode,finalExec,posRel,distD1,effort,trigger);
+return false; }
+      if(!OrderCalcMargin(type,Symbol(),lots,finalExec,margin) || !MathIsValidNumber(margin)
+|| margin<0 || AccountInfoDouble(ACCOUNT_MARGIN_FREE)<margin)
+      { WriteAuditRow("NO_MARGIN",dStr,mode,finalExec,posRel,distD1,effort,trigger); return
+false; }
+   }
+   closingQuote=(direction==1)?dispatchTick.bid:dispatchTick.ask;
+   if(direction*(finalExec-sl)<minDist || (tp>0 && direction*(tp-finalExec)<minDist) ||
+      direction*(closingQuote-sl)<minDist || (tp>0 && direction*(tp-closingQuote)<minDist))
+   {
+WriteAuditRow("STOPS_LEVEL_BLOCK",dStr,mode,finalExec,posRel,distD1,effort,trigger);
+return false; }
+   if(HasOpenPosition()) return false;
+   if(HasOwnPendingOrder() || HasExecutionInFlight())
+   {
+WriteAuditRow("LATE_PENDING_BLOCK",dStr,mode,finalExec,posRel,distD1,effort,trigger)
+; return false; }
+   // Validate the executable quote again AFTER calculations, then finish all
+   // guards before touching the durable financial preparation protocol.
+   MqlTick lastDispatchTick;
+   if(armed.entry.enabled)
+   {
+      if(!SymbolInfoTick(Symbol(),lastDispatchTick) || !EntryDispatchGuard(lastDispatchTick)) return false;
+      // Preserve the original recalculation protocol if this quote moved.
+      double lastExec=direction==1?lastDispatchTick.ask:lastDispatchTick.bid;
+      if(lastExec!=finalExec)
+      {
+         finalExec=lastExec;
+         sl=NormEntrySL(direction,finalExec-direction*slPts);
+         tp=(Inp_ExitMode==PROGRESSIVE_NO_TP)?0.0:NormEntryTP(direction,finalExec+direction*tpPts);
+         lots=ComputeLotsForEntry(direction,finalExec,sl);
+         if(lots<=0 || !OrderCalcMargin(type,Symbol(),lots,finalExec,margin) ||
+            !MathIsValidNumber(margin) || margin<0 || AccountInfoDouble(ACCOUNT_MARGIN_FREE)<margin)
+         { WriteAuditRow("NO_MARGIN",dStr,mode,finalExec,posRel,distD1,effort,trigger); return false; }
+      }
+      closingQuote=direction==1?lastDispatchTick.bid:lastDispatchTick.ask;
+      if(sl<=0 || !EntryTPValid(tp) || direction*(finalExec-sl)<minDist ||
+         (tp>0 && direction*(tp-finalExec)<minDist) || direction*(closingQuote-sl)<minDist ||
+         (tp>0 && direction*(tp-closingQuote)<minDist))
+      { WriteAuditRow("STOPS_LEVEL_BLOCK",dStr,mode,finalExec,posRel,distD1,effort,trigger); return false; }
+      if(!ClaimEntryDispatch(armed.entry)) return false;
+      armed.dispatchQuoteMsc=lastDispatchTick.time_msc;
+      armed.dispatchAsk=lastDispatchTick.ask; armed.dispatchBid=lastDispatchTick.bid;
+      armed.requestPrice=finalExec;
+   }
+   if(!armed.entry.enabled)
+   {
+      armed.dispatchQuoteMsc=dispatchTick.time_msc;
+      armed.dispatchAsk=dispatchTick.ask; armed.dispatchBid=dispatchTick.bid;
+      armed.requestPrice=finalExec;
+   }
+   armed.lots=lots; // execution telemetry only; never Stage 1 risk sizing
+   if(!PreparePendingExec(direction,armed.route,mode,finalExec,lots,sl,tp)) return false;
+  gPendingExec.breakoutPrice=gLastBreakoutPrice;
+  gPendingExec.breakoutPriceAvailable=gLastBreakoutPrice>0;
+  if(!MarkRequestDispatchPossible(false))
+  { ResetPendingExec(); return false; } // No dispatch occurred; absence is proved locally.
+  // Only capture memory here: diagnostic disk/history IO occurs after the
+  // original financial completion protocol, never between barrier and send.
+  int entryDiagnosticIndex=RememberEntryDispatch();
+  bool
+sent=trade.PositionOpen(Symbol(),type,lots,finalExec,sl,tp,"S1995|"+armed.route+"|"+mode);
+  uint ret=trade.ResultRetcode();
+  MqlTradeResult executionResult;
+  trade.Result(executionResult);
+
+CompletePendingExec(sent,ret,trade.ResultOrder(),trade.ResultDeal(),executionResult.request_id);
+ BindEntryDispatch(entryDiagnosticIndex,executionResult.order,executionResult.deal,executionResult.request_id);
+ bool accepted=sent && (ret==TRADE_RETCODE_DONE ||
+ret==TRADE_RETCODE_PLACED || ret==TRADE_RETCODE_DONE_PARTIAL);
+
+WriteAuditRow(accepted?"REQUEST_ACCEPTED":"ORDER_FAILED",dStr,mode,finalExec
+,posRel,distD1,effort,trigger);
+  return accepted;
+}
+
+//=====================================================================
+// STAGE 1 — EVALUATE MATRIX
+//=====================================================================
+
+
+void EvaluateMatrix()
+{
+   datetime bar=iTime(Symbol(),Inp_SignalTF,0);
+   if(bar<=gObjectiveAttachBar || bar==gLastMatrixEvalBar) return;
+   OMThesis s;
+   datetime closed=iTime(Symbol(),Inp_SignalTF,1);
+   if(closed<=0 || closed+PeriodSeconds(Inp_SignalTF)!=bar || !OMGetClosed(closed,s)) return;
+   if(armed.active) return;
+   if(!s.detected || !s.eligible) { gLastMatrixEvalBar=bar; return; }
+   if(gAccountingUnresolved || HasExecutionInFlight() || HasOpenPosition()) return;
+   if((s.route=="ABS" && !Inp_EnableAbsorption) || (s.route=="CONT" && !Inp_EnableContinuation))
+   { gLastMatrixEvalBar=bar; return; }
+   double signalClose=iClose(Symbol(),Inp_SignalTF,1);
+   if(!EntryGridValid(signalClose) || signalClose!=s.price)
+   {
+      ArmedSignal rejected; ZeroMemory(rejected);
+      rejected.signalID=NewEntrySignalID(); rejected.entryReason="M1_TRADE_CLOSE_MISMATCH";
+      rejected.entry.signalReferencePrice=signalClose;
+      WriteEntryDiagnostic(rejected,"M1_TRADE_CLOSE_MISMATCH");
+      gLastMatrixEvalBar=bar; return;
+   }
+   MqlTick clock;
+   if(!SymbolInfoTick(Symbol(),clock) || !OMLiveReady(clock.time_msc) ||
+      clock.time_msc<(long)bar*1000 || clock.last!=gOMLastPrice) return;
+   gLastMatrixEvalBar=bar;
+   EntryTriggerState entry; string reason;
+   if(!InitSignalCloseTrigger(entry,s.dir,signalClose,gBreakoutMargin,clock.time_msc,reason)) return;
+   if(s.route=="CONT" && !ObjectiveContInsideB3(s.dir,entry.trigger,s.bands))
+   {
+      ArmedSignal rejected; ZeroMemory(rejected);
+      rejected.dir=s.dir; rejected.route=s.route;
+      rejected.mode=s.route=="CONT"?"BASE_CONT":"BASE";
+      rejected.entry=entry; rejected.signalID=NewEntrySignalID();
+      rejected.entryReason="CONT_TRIGGER_OUTSIDE_B3";
+      WriteEntryDiagnostic(rejected,"CONT_TRIGGER_OUTSIDE_B3"); return;
+   }
+   if(iTime(Symbol(),Inp_SignalTF,0)!=bar) return;
+   ZeroMemory(armed); armed.active=true; armed.dir=s.dir;
+   armed.route=s.route; armed.mode=s.route=="CONT"?"BASE_CONT":"BASE";
+   armed.activeSL_Pts=gSL_Pts; armed.activeTP_Pts=gTP_Pts;
+   armed.armedAt=TimeTradeServer(); armed.regionEndTime=iTime(Symbol(),Inp_SignalTF,1);
+   armed.effort=s.effort; armed.vwapVig=s.bands.vwap; armed.entry=entry;
+   armed.signalID=NewEntrySignalID(); armed.entryReason="SIGNAL_DETECTED";
+   gObjectiveArmed=s;
+   // Exact original default two closed M1 extremes, EXCLUSIVELY for FAR protection.
+   // A failed collection does not block arm or invent favorable FAR evidence.
+   MqlRates region[];
+   if(CopyRates(Symbol(),Inp_SignalTF,1,2,region)==2)
+   {
+      bool valid=true; double high=0,low=DBL_MAX;
+      for(int i=0;i<2;i++)
+      {
+         if(!FARPriceValid(region[i].high) || !FARPriceValid(region[i].low) ||
+            region[i].high<region[i].low) { valid=false; break; }
+         high=MathMax(high,region[i].high); low=MathMin(low,region[i].low);
+      }
+      if(valid) { armed.regionHigh=high; armed.regionLow=low; }
+   }
+   gCachedMicroBar=bar;
+   FARCaptureArm();
+   WriteEntryDiagnostic(armed,"SIGNAL_DETECTED");
+   WriteAuditRow("ARMED",DirStr(armed.dir),armed.mode,signalClose,0,0,s.effort,entry.trigger);
+}
