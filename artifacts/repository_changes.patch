+bool TradeCsvContainsPID(ulong positionID)
+{
+  for(int i=0;i<ArraySize(gTradeCsvWrittenPIDs);i++)
+   if(gTradeCsvWrittenPIDs[i] == positionID) return true;
+  return false;
+}
