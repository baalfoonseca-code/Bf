+// The new modes revalidate the original live filters on the final quote too.
+// No new threshold, timer or interpretation of FAR is introduced here.
+bool ObjectiveContInsideB3(int dir,double price,const OMBands &bands)
+{
+   if(!bands.ready || !MathIsValidNumber(price) || price<=0 ||
+      !MathIsValidNumber(bands.upper3) || !MathIsValidNumber(bands.lower3)) return false;
+   if(dir==1) return price<bands.upper3;
+   if(dir==-1) return price>bands.lower3;
+   return false;
+}
+
+bool ObjectiveRevalidate(string &reason)
+{
+   reason="THESIS_INDETERMINATE";
+   if(!armed.active || !armed.entry.enabled) return false;
+   int validity=OMRevalidate(gObjectiveArmed,reason);
+   if(validity<0)
+   {
+      WriteAuditRow("THESIS_INVALIDATED_"+reason,DirStr(armed.dir),armed.mode,0,0,0,0,ArmedTriggerPrice());
+      ResetArmedSignal(); return false;
+   }
+   return validity==1;
+}
+
+bool EntryDispatchGuard(const MqlTick &tk)
+{
+   // No strategic cancellation may erase ownership of a financial request.
+   if(!armed.active || !armed.entry.enabled || gAccountingUnresolved ||
+      HasExecutionInFlight() || HasOpenPosition()) return false;
+   string reason;
+   if(EntryTimeoutExpired(armed.armedAt,TimeTradeServer(),Inp_ArmedTimeoutSec))
+   {
+      WriteAuditRow("TIMEOUT_ARMED",DirStr(armed.dir),armed.mode,0,0,0,0,ArmedTriggerPrice());
+      ResetArmedSignal(); return false;
+   }
+   if(!EntryGridValid(tk.ask) || !EntryGridValid(tk.bid) || tk.ask<tk.bid) return false;
+   if(armed.route=="CONT" &&
+      !ObjectiveContInsideB3(armed.dir,armed.dir==1?tk.ask:tk.bid,gObjectiveArmed.bands))
+   {
+      WriteAuditRow("CONT_EXEC_OUTSIDE_B3",DirStr(armed.dir),armed.mode,tk.last,0,0,0,ArmedTriggerPrice());
+      ResetArmedSignal(); return false;
+   }
+   if(EntryRealTrade(tk) && tk.time_msc>armed.entry.thesisMsc &&
+      (armed.dir==1?tk.last>=armed.entry.trigger:tk.last<=armed.entry.trigger))
+   {
+      double overLast=armed.dir*(tk.last-armed.entry.trigger);
+      double overExec=armed.dir*((armed.dir==1?tk.ask:tk.bid)-armed.entry.trigger);
+      if(MathMax(overLast,overExec)>gMaxOvershoot)
+      { WriteAuditRow("OVERSHOOT_BLOCK",DirStr(armed.dir),armed.mode,tk.last,0,0,0,ArmedTriggerPrice()); ResetArmedSignal(); return false; }
+   }
+   if(tk.last!=gOMLastPrice || !OMLiveReady(tk.time_msc) || !ObjectiveRevalidate(reason)) return false; // unknown continuation is never approval
+   if(tk.ask-tk.bid>gSpreadMaxPts) reason="HOLD_SPREAD";
+   else if(ValidateEntryDispatch(armed.entry,tk,reason))
+   {
+      double overLast=armed.dir*(tk.last-armed.entry.trigger);
+      double overExec=armed.dir*((armed.dir==1?tk.ask:tk.bid)-armed.entry.trigger);
+      if(MathMax(overLast,overExec)<=gMaxOvershoot)
+      { armed.entryReason="DISPATCH_GUARD"; return true; }
+      WriteAuditRow("OVERSHOOT_BLOCK",DirStr(armed.dir),armed.mode,tk.last,0,0,0,ArmedTriggerPrice());
+      ResetArmedSignal(); return false;
+   }
+   WriteAuditRow(reason,DirStr(armed.dir),armed.mode,tk.last,0,0,0,ArmedTriggerPrice());
+   return false;
+}
