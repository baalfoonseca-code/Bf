+//=====================================================================
+// STAGE 2 — PROCESS ARMED SIGNAL
+// Preserva toda a lógica da v2.44.
+//=====================================================================
+void ProcessArmedSignal()
+{
+   if(!armed.active || HasExecutionInFlight() || HasOpenPosition() || gAccountingUnresolved) return;
+   datetime now=TimeTradeServer();
+   if(EntryTimeoutExpired(armed.armedAt,now,Inp_ArmedTimeoutSec))
+   { WriteAuditRow("TIMEOUT_ARMED",DirStr(armed.dir),armed.mode,0,0,0,0,ArmedTriggerPrice()); ResetArmedSignal(); return; }
+   MqlDateTime dt; TimeToStruct(now,dt);
+   if(dt.hour*100+dt.min>=Inp_StopEntryHHMM)
+   { WriteAuditRow("ABORT_SESSION_END",DirStr(armed.dir),armed.mode,0,0,0,0,ArmedTriggerPrice()); ResetArmedSignal(); return; }
+   if(ordersEnteredToday>=Inp_MaxTradesDay || dailyRiskBlocked) return;
+   MqlTick tk;
+   if(!SymbolInfoTick(Symbol(),tk)) return;
+   if(!EntryGridValid(tk.ask) || !EntryGridValid(tk.bid) || tk.ask<tk.bid) return;
+   // Original terminal overshoot precedes the spread hold and strategy data work.
+   // Only an actual post-thesis trade beyond the frozen trigger is evidence.
+   if(EntryRealTrade(tk) && tk.time_msc>armed.entry.thesisMsc &&
+      (armed.dir==1?tk.last>=armed.entry.trigger:tk.last<=armed.entry.trigger))
+   {
+      double overLast=armed.dir*(tk.last-armed.entry.trigger);
+      double overExec=armed.dir*((armed.dir==1?tk.ask:tk.bid)-armed.entry.trigger);
+      if(MathMax(overLast,overExec)>gMaxOvershoot)
+      { WriteAuditRow("OVERSHOOT_BLOCK",DirStr(armed.dir),armed.mode,tk.last,0,0,0,ArmedTriggerPrice()); ResetArmedSignal(); return; }
+   }
+   string reason;
+   if(!ObjectiveRevalidate(reason)) return;
+   if(FARBeforeDecision()) return;
+   if(!OMLiveReady(tk.time_msc)) return;
+   // Geography may invalidate before trigger confirmation, but never closes a position.
+   if(armed.route=="CONT" &&
+      !ObjectiveContInsideB3(armed.dir,armed.dir==1?tk.ask:tk.bid,gObjectiveArmed.bands))
+   { WriteAuditRow("CONT_EXEC_OUTSIDE_B3",DirStr(armed.dir),armed.mode,tk.last,0,0,0,ArmedTriggerPrice()); ResetArmedSignal(); return; }
+   if(ObserveEntryTrade(armed.entry,tk,reason)==1)
+      WriteAuditRow("TRIGGER_CONFIRMED",DirStr(armed.dir),armed.mode,tk.last,0,0,0,ArmedTriggerPrice());
+   // Quote-only callbacks can use already-proven Last without inventing a new trade.
+   if(!EntryDispatchGuard(tk)) return;
+   if(!SpreadOk()) return;
+   double trigger=ArmedTriggerPrice();
+   gLastBreakoutPrice=tk.last;
+   WriteEntryDiagnostic(armed,"DISPATCH_CANDIDATE");
+   SendOrder(armed.dir,armed.lots,armed.mode,armed.activeSL_Pts,armed.activeTP_Pts,
+             armed.posRel,armed.distD1,armed.effort,trigger);
+   if(!armed.active) return;
+   // A transient pre-preparation guard failure may wait within the ORIGINAL timeout.
+   // A claimed/attempted signal is never sent twice; financial ambiguity owns recovery.
+   if(armed.entry.dispatchAttempted || HasExecutionInFlight() || HasOpenPosition()) ResetArmedSignal();
+}
