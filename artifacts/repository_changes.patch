+//=====================================================================
+// ON TICK
+//=====================================================================
+// Accounting/execution uncertainty still blocks entries. This observer has no
+// access to the arming path and does not populate its shared snapshot cache.
+
+
+void ObjectiveDecisionCycle()
+{
+   datetime bar=iTime(Symbol(),Inp_SignalTF,0);
+   if(bar<=0) return;
+   // Observation never changes an existing thesis, its trigger, or its timeout.
+   datetime closed=iTime(Symbol(),Inp_SignalTF,1);
+   OMThesis observed;
+   if(closed>0 && closed!=gObjectiveObservedBar && OMGetClosed(closed,observed))
+   {
+      gObjectiveObservedBar=closed;
+      if(armed.active) OMTelemetry("OBSERVATION_WHILE_ARMED",observed);
+      else if(gAccountingUnresolved || HasExecutionInFlight() || HasOpenPosition())
+         OMTelemetry("OBSERVATION_FINANCIAL_BLOCK",observed);
+   }
+   // Closed snapshots are observed even when an older thesis or finance blocks arming.
+   if(armed.active)
+   {
+      ProcessArmedSignal();
+      // Do not arm a replacement in the event that invalidated the prior thesis.
+      return;
+   }
+   MqlDateTime dt; TimeToStruct(TimeTradeServer(),dt);
+   int hhmm=dt.hour*100+dt.min;
+   if(hhmm<Inp_StartHHMM || hhmm>=Inp_StopEntryHHMM) return;
+   if(HasOpenPosition() || HasExecutionInFlight() || ordersEnteredToday>=Inp_MaxTradesDay ||
+      dailyRiskBlocked || gAccountingUnresolved) return;
+   if(Inp_CooldownSec>0 && lastCloseConfirmedTime>0 &&
+      TimeTradeServer()-lastCloseConfirmedTime<Inp_CooldownSec) return;
+   if(Inp_LossCooldownSec>0 && lastTradeWasLoss && lastCloseConfirmedTime>0 &&
+      TimeTradeServer()-lastCloseConfirmedTime<Inp_LossCooldownSec) return;
+   EvaluateMatrix();
+}
+
+void OnTick()
+{
+  if(TimeCurrent()<BacktestStart) return;
+  MqlDateTime day; TimeToStruct(TimeTradeServer(),day);
+  int key=day.year*1000+day.day_of_year;
+  if(key!=gDayKey) { gDayKey=key; DailyReset(); }
+ SyncAccountingState();
+ if(gOpenPos.active) UpdateMAEMFE();
+ int hhmm=day.hour*100+day.min;
+ ProcessEOD(hhmm);
+ ManageBreakEven();
+ if(hhmm>=Inp_StopEntryHHMM && armed.active) ResetArmedSignal();
+ // OBJECTIVE_DATA_AFTER_FINANCE
+ // No history collection on the tick path. Quotes wait for verified timer catch-up.
+ ObjectiveDecisionCycle();
+}
+
+//=====================================================================
+// ON TIMER
+//=====================================================================
+void OnTimer()
+{
+  if(TimeCurrent()<BacktestStart) return;
+  // Keep the original financial timer cadence (tester60/live1 seconds).
+  // Only analytical catch-up runs at the finer one-second tester schedule.
+  datetime now=TimeTradeServer();
+  bool financeDue=now>=gFinancialTimerDue;
+  if(financeDue)
+  {
+     gFinancialTimerDue=now+(MQLInfoInteger(MQL_TESTER)!=0?60:1);
+  MqlDateTime nowDT; TimeToStruct(TimeTradeServer(),nowDT);
+  int key=nowDT.year*1000+nowDT.day_of_year;
+ int hhmm=nowDT.hour*100+nowDT.min;
+ if(key!=gDayKey) { gDayKey=key; DailyReset(); }
+ SyncAccountingState(true);
+ ReconcileBreakEvenProofs(); // Proof/persistence only; never dispatches a stop modification.
+ if(hhmm>=Inp_StopEntryHHMM && armed.active) ResetArmedSignal();
+ ProcessEOD(hhmm);
+  }
+ OMService();
+ ObjectiveDecisionCycle(); // A verified current trade may confirm an already armed signal.
+ if(financeDue && now-gLastFlushTime>=30)
+ {
+    gLastFlushTime=now;
+    if(gEntryDiagnosticHandle!=INVALID_HANDLE) FileFlush(gEntryDiagnosticHandle);
+    if(csvTradeHandle!=INVALID_HANDLE) FileFlush(csvTradeHandle);
+ }
+}
+
+//=====================================================================
+// ON TRADE TRANSACTION
+// Trata DEAL_ENTRY_IN (entrada) e DEAL_ENTRY_OUT (saída).
+// Agrupa por DEAL_POSITION_ID.
+// Exige flat, salvo ciclo próprio fechado com residual INOUT explicitamente estrangeiro.
+//=====================================================================
+
+
+//=====================================================================
+// ON TESTER
+//=====================================================================
+//=====================================================================
+// RC1 execution context, confirmed quota and positionID accounting
+//=====================================================================
+// BE-only lifecycle. Initial TradeRecord.slPrice/risk and all entry rules stay unchanged.
+double BEPrice(double entry)
+{ return NormPriceDigits(MathRound(entry/gTickSize)*gTickSize); }
+
+// Conservative rounding: never claim more protected R than requested.
+double ProtectionPrice(int direction,double entry,double initialSL,int level,bool progressive)
+{
+   if(!progressive) return BEPrice(entry);
+   double raw=entry+direction*level*MathAbs(entry-initialSL);
+   double price=NormPriceDigits((direction==1?MathFloor(raw/gTickSize):MathCeil(raw/gTickSize))*gTickSize);
+   if(direction*(price-raw)>0)
+      price=NormPriceDigits(price-direction*gTickSize);
+   return price;
+}
+
+// Numeric kernel: executable price must actually cross the trigger, without an epsilon
+// that could anticipate a tick. Direct multi-R jumps are allowed.
+int ProtectionEligibleLevel(int direction,double entry,double initialSL,double executable,
+                            int maximum,bool progressive)
+{
+   double risk=MathAbs(entry-initialSL);
+   if(!Positive(risk) || !Positive(executable) || (direction!=1 && direction!=-1)) return -1;
+   // Compare prices directly: subtracting a fractional entry from its exact
+   // represented trigger can round below R. No epsilon may advance a trigger.
+   double firstTrigger=entry+direction*risk;
+   bool reached=(direction==1?executable>=firstTrigger:executable<=firstTrigger);
+   if(!reached) return -1;
+   if(!progressive) return 0;
+   int eligible=-1;
+   for(int level=0;level<=maximum;level++)
+   {
+      double trigger=entry+direction*(level+1)*risk;
+      if((direction==1 && executable>=trigger) || (direction==-1 && executable<=trigger))
+         eligible=level;
+   }
+   return eligible;
+}
+
+
+bool BEPriceEqual(double a,double b)
+{ return MathIsValidNumber(a) && MathIsValidNumber(b) &&
+MathAbs(a-b)<=gTickSize*0.000001; }
+
+double BERiskPoints(const TradeRecord &r)
+{ return MathAbs(r.weightedEntryPrice-r.slPrice); }
+
+bool BEReferenceValid(const TradeRecord &r)
+{
+   bool progressive=(r.be.exitMode==(int)PROGRESSIVE_NO_TP);
+   if(r.be.exitMode!=(int)ORIGINAL_FIXED_TP && !progressive) return false;
+   return r.initialStopsProven && r.riskValid && r.accountingResolved &&
+      Positive(r.weightedEntryPrice) && Positive(r.slPrice) &&
+      (r.direction==1 || r.direction==-1) &&
+      r.direction*(r.weightedEntryPrice-r.slPrice)>0 &&
+      r.be.direction==r.direction && BEPriceEqual(r.be.entryPrice,r.weightedEntryPrice) &&
+      BEPriceEqual(r.be.initialSL,r.slPrice) && Positive(r.be.price) &&
+      r.be.targetLevel>=0 && r.be.targetLevel<=(progressive?5:0) &&
+      r.be.confirmedLevel>=-1 && r.be.confirmedLevel<=r.be.targetLevel &&
+      BEPriceEqual(r.be.price,ProtectionPrice(r.direction,r.be.entryPrice,r.be.initialSL,
+                                             r.be.targetLevel,progressive)) &&
+      (r.be.confirmedLevel<0 || BEPriceEqual(r.be.confirmedPrice,
+         ProtectionPrice(r.direction,r.be.entryPrice,r.be.initialSL,r.be.confirmedLevel,progressive))) &&
+      (!progressive || r.be.tp==0);
+}
+
+
+bool BETriggerReached(const TradeRecord &r,const MqlTick &tick)
+{
+   return ProtectionEligibleLevel(r.direction,r.weightedEntryPrice,r.slPrice,
+      r.direction==1?tick.bid:tick.ask,Inp_MaxProtectedR,
+      Inp_ExitMode==PROGRESSIVE_NO_TP)>=0;
+}
+
+
+void BELog(const TradeRecord &r,string event,string detail="")
+{
+  PrintFormat("[SCALPER][%s] POSITION_ID=%I64u ticket=%I64u dir=%s entry=%.16f initialSL=%.16f R_points=%.16f trigger=%.16f newSL=%.16f TP_preserved=%.16f %s",
+     event,r.positionID,r.be.ticket,DirStr(r.be.direction),r.be.entryPrice,r.be.initialSL,
+     MathAbs(r.be.entryPrice-r.be.initialSL),
+     r.be.entryPrice+r.be.direction*MathAbs(r.be.entryPrice-r.be.initialSL),
+     r.be.price,r.be.tp,detail);
+}
