+bool TradeCsvAddPID(ulong positionID)
+{
+  if(TradeCsvContainsPID(positionID)) return true;
+  int n=ArraySize(gTradeCsvWrittenPIDs);
+  if(ArrayResize(gTradeCsvWrittenPIDs,n+1) != n+1) return false;
