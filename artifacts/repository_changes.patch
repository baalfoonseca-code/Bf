+void WriteTradeHeader()
+{
+  if(csvTradeHandle == INVALID_HANDLE) return;
+  string line = "";
+  CsvConfigHeader(line);
+  CsvTradeHeader(line);
+  FileWriteString(csvTradeHandle,line + "\r\n");
