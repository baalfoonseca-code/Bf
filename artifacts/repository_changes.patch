+def lexical_mask(source):
+    """Preserve offsets/newlines while masking MQL strings and comments."""
+    result = list(source)
+    state = "code"
+    index = 0
+    while index < len(source):
+        character = source[index]
+        pair = source[index:index + 2]
+        if state == "code":
+            if pair in ("//", "/*"):
+                result[index:index + 2] = "  "
+                state = "line" if pair == "//" else "block"
+                index += 2
+                continue
+            if character in ("\"", "'"):
+                state = character
+                result[index] = " "
+        elif state == "line":
+            if character == "\n":
+                state = "code"
+            else:
+                result[index] = " "
+        elif state == "block":
+            if pair == "*/":
+                result[index:index + 2] = "  "
+                state = "code"
+                index += 2
+                continue
+            if character != "\n":
+                result[index] = " "
+        elif character == "\\":
+            result[index] = " "
+            if index + 1 < len(source) and source[index + 1] != "\n":
+                result[index + 1] = " "
+            index += 2
+            continue
+        elif character == state:
+            result[index] = " "
+            state = "code"
+        elif character != "\n":
+            result[index] = " "
+        index += 1
+    if state not in ("code", "line"):
+        raise ValueError("Unterminated literal/comment in source")
+    return "".join(result)
