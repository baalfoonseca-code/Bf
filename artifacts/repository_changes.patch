+int FindTrackedTrade(ulong positionID)
+{
+  for(int i=0;i<gTradeRecordCount;i++)
+   if(gTradeRecords[i].positionID==positionID) return i;
+  return -1;
+}
+// 1: proved current-version entry; 0: proved foreign/non-entry; -1: unavailable proof.
+// The originating order and account-scoped history establish identity, not Magic alone.
+int Identify1995EntryDeal(ulong deal)
+{
+   if(deal==0) return -1;
+   ResetLastError();
+   string symbol=HistoryDealGetString(deal,DEAL_SYMBOL);
+   long magic=HistoryDealGetInteger(deal,DEAL_MAGIC);
+   long entry=HistoryDealGetInteger(deal,DEAL_ENTRY);
+   long type=HistoryDealGetInteger(deal,DEAL_TYPE);
+   ulong order=(ulong)HistoryDealGetInteger(deal,DEAL_ORDER);
+   ulong pid=(ulong)HistoryDealGetInteger(deal,DEAL_POSITION_ID);
+   if(GetLastError()!=0) return -1;
+   if(symbol!=Symbol() || magic!=(long)gMagicCore || entry!=DEAL_ENTRY_IN ||
+      (type!=DEAL_TYPE_BUY && type!=DEAL_TYPE_SELL)) return 0;
+   if(order==0 || pid==0 || !HistoryOrderSelect(order)) return -1;
+   ResetLastError();
+   string orderSymbol=HistoryOrderGetString(order,ORDER_SYMBOL);
+   long orderMagic=HistoryOrderGetInteger(order,ORDER_MAGIC);
+   ulong orderPID=(ulong)HistoryOrderGetInteger(order,ORDER_POSITION_ID);
+   string comment=HistoryOrderGetString(order,ORDER_COMMENT);
+   if(GetLastError()!=0 || orderPID==0) return -1;
+   if(orderSymbol!=Symbol() || orderMagic!=(long)gMagicCore || orderPID!=pid) return -1;
+   // Explicit legacy identity is a conflict, never a source for this version's ledger.
+   string legacy="RC"+"1|";
+   if(comment==legacy+"ABS|BASE" || comment==legacy+"ABS|TURBO" ||
+      comment==legacy+"CONT|BASE_CONT" || comment==legacy+"CONT|TURBO_CONT" ||
+      comment=="SCALPER_BASE" || comment=="SCALPER_TURBO" ||
+      comment=="SCALPER_BASE_CONT" || comment=="SCALPER_TURBO_CONT") return 0;
+   string route,mode;
+   if(StringFind(comment,"S1995|")!=0 || !ParseScalperComment(comment,route,mode)) return -1;
+   string dealRoute,dealMode;
+   if(ParseScalperComment(HistoryDealGetString(deal,DEAL_COMMENT),dealRoute,dealMode) &&
+      (dealRoute!=route || dealMode!=mode)) return -1;
+   return 1;
+}
+
+bool Is1995EntryDeal(ulong deal)
+{
+   int identity=Identify1995EntryDeal(deal);
+   if(identity<0) MarkTemporaryAccountingHistory();
+   return identity==1;
+}
