+// ENTRY_CORE_BEGIN
+bool EntryGridValid(double price)
+{
+   return MathIsValidNumber(gTickSize) && gTickSize>0 &&
+      MathIsValidNumber(price) && price>0 &&
+      MathAbs(price/gTickSize-MathRound(price/gTickSize))<=1e-6;
+}
+bool EntryTimeoutExpired(datetime armedAt,datetime now,int timeout)
+{
+   return armedAt>0 && now>=armedAt && now-armedAt>=(datetime)timeout;
+}
+bool InitSignalCloseTrigger(EntryTriggerState &e,int dir,double signalClose,
+                           double margin,long thesisMsc,string &reason)
+{
+   ZeroMemory(e); reason="SIGNAL_CLOSE_INVALID";
+   if((dir!=1 && dir!=-1) || !EntryGridValid(signalClose) ||
+      !MathIsValidNumber(margin) || margin<=0 || thesisMsc<=0) return false;
+   e.dir=dir; e.signalReferencePrice=signalClose; e.margin=margin;
+   e.trigger=dir==1?RoundUpTick(signalClose+margin):RoundDownTick(signalClose-margin);
+   if(!EntryGridValid(e.trigger)) return false;
+   e.enabled=true; e.triggerReady=true; e.thesisMsc=thesisMsc;
+   e.phase=ENTRY_WAIT_CONFIRMATION; reason="SIGNAL_CLOSE_FROZEN";
+   return true;
+}
+bool EntryRealTrade(const MqlTick &tk)
+{
+   uint tradeFlags=TICK_FLAG_LAST|TICK_FLAG_VOLUME|TICK_FLAG_BUY|TICK_FLAG_SELL;
+   return tk.time_msc>0 && tk.time>0 && (long)tk.time==tk.time_msc/1000 &&
+      (tk.flags&tradeFlags)!=0 && EntryGridValid(tk.last) &&
+      MathIsValidNumber(tk.volume_real) && tk.volume_real>=0 &&
+      (tk.volume_real>0 || tk.volume>0);
+}
+// 0 waiting, 1 current verified confirmation. Same-ms events
+// cannot prove sequence here and never serve as a second trade.
+int ObserveEntryTrade(EntryTriggerState &e,const MqlTick &tk,string &reason)
+{
+   reason="WAIT_REAL_POST_THESIS_TRADE";
+   if(!e.enabled || e.phase==ENTRY_DISABLED || e.dispatchAttempted || !EntryRealTrade(tk) ||
+      tk.time_msc<=e.thesisMsc || tk.time_msc<e.lastTradeMsc) return 0;
+   if(tk.time_msc==e.lastTradeMsc) return 0;
+   e.lastTradeMsc=tk.time_msc; e.confirmationMsc=0; e.confirmationPrice=0;
+   e.phase=ENTRY_WAIT_CONFIRMATION; reason="WAIT_CONFIRMATION";
+   if(!e.triggerReady || (e.dir==1?tk.last<e.trigger:tk.last>e.trigger)) return 0;
+   e.confirmationMsc=tk.time_msc; e.confirmationPrice=tk.last;
+   e.phase=ENTRY_READY; reason="REAL_TRADE_CONFIRMED"; return 1;
+}
+bool ValidateEntryDispatch(EntryTriggerState &e,const MqlTick &tk,string &reason)
+{
+   reason="CONFIRMATION_UNAVAILABLE";
+   if(!e.enabled || e.dispatchAttempted) return false;
+   if(tk.time_msc<=0 || tk.time<=0 || (long)tk.time!=tk.time_msc/1000)
+   { reason="DISPATCH_CLOCK_INVALID"; return false; }
+   uint tradeFlags=TICK_FLAG_LAST|TICK_FLAG_VOLUME|TICK_FLAG_BUY|TICK_FLAG_SELL;
+   if((tk.flags&tradeFlags)!=0 && !EntryRealTrade(tk))
+   { reason="DISPATCH_TRADE_INVALID"; return false; }
+   // A new trade arriving during FAR/sizing must be evaluated before dispatch.
+   // A quote-only update may retain independently verified Last evidence.
+   if(EntryRealTrade(tk) && tk.time_msc>e.lastTradeMsc)
+   {
+      int result=ObserveEntryTrade(e,tk,reason);
+      if(result<0) return false;
+   }
+   if(e.phase!=ENTRY_READY || e.confirmationMsc<=e.thesisMsc ||
+      tk.time_msc<e.lastTradeMsc || tk.time_msc<e.confirmationMsc ||
+      !EntryGridValid(tk.last) || tk.last!=e.confirmationPrice) return false;
+   if(!EntryGridValid(tk.ask) || !EntryGridValid(tk.bid) || tk.ask<tk.bid)
+   { reason="DISPATCH_QUOTE_INVALID"; return false; }
+   double exec=e.dir==1?tk.ask:tk.bid;
+   if(e.dir==1?exec<e.trigger:exec>e.trigger)
+   { reason="DISPATCH_TRIGGER_LOST"; return false; }
+   reason="DISPATCH_GUARD_OK"; return true;
+}
+bool ClaimEntryDispatch(EntryTriggerState &e)
+{
+   if(!e.enabled || e.dispatchAttempted || e.phase!=ENTRY_READY) return false;
+   e.dispatchAttempted=true; return true;
+}
