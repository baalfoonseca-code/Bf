+string CsvCell(string value)
+{
+  if(StringLen(value) == 0) return "\"\"";
+   bool quoted = StringFind(value,",") >= 0 || StringFind(value,"\"") >= 0 ||
+         StringFind(value,"\r") >= 0 || StringFind(value,"\n") >= 0;
+   if(!quoted) return value;
+   StringReplace(value,"\"","\"\"");
+   return "\"" + value + "\"";
+}
