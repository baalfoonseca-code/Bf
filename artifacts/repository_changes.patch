+// ENTRY_DIAGNOSTICS_BEGIN
+// Separate experimental diagnostic stream. Never reads/writes a financial
+// journal and never decides whether an order may be sent. Live correlation
+// below is intentionally not restored after terminal/EA restart; the original
+// financial recovery protocol remains authoritative and unchanged.
+int gEntryDiagnosticHandle=INVALID_HANDLE;
+string gEntryInstanceID="",gEntryDiagnosticFile="";
+ulong gEntrySignalSequence=0;
+struct EntryDispatchDiagnostic
+{
+   ArmedSignal signal;
+   ulong orderTicket,resultDeal;
+   uint requestID;
+};
+EntryDispatchDiagnostic gEntryDispatchDiagnostics[];
+ulong gEntryObservedDeals[];
+ulong gEntryCandidateDeals[]; // Covers DEAL_ADD arriving before result identity binding.
+
+string NewEntrySignalID()
+{
+   gEntrySignalSequence++;
+   return gEntryInstanceID+"_S"+(string)gEntrySignalSequence;
+}
+
+void EntryDiagnosticHeader()
+{
+   string line="ENTRY_SCHEMA,EVENT,SIGNAL_ID,SYMBOL,MAGIC,ROUTE,DIRECTION,MODE,THESIS_MSC,SIGNAL_CLOSE,TRIGGER,CONFIRMATION_MSC,CONFIRMATION_LAST,DISPATCH_MSC,ASK,BID,REQUEST_PRICE,ORDER_ID,DEAL_ID,FILL_PRICE,FILL_VOLUME,FILL_MSC,REASON,ARMED_AT,TIMEOUT_SEC,DISPATCH_ATTEMPTED,REQUEST_ID,RETCODE,TRIGGER_DELAY_MSC,QUOTE_DELAY_MSC,QUOTE_TO_FILL_MSC,OBSERVATION_CLOCK";
+   FARHeader(line);
+   FileWriteString(gEntryDiagnosticHandle,line+"\r\n");
+}
+
+bool EntryDiagnosticsInit()
+{
+   // Account + symbol + magic + chart + wall-clock + monotonic component;
+   // filesystem collision check also protects a pre-existing diagnostic file.
+   gEntryInstanceID=StringFormat("%I64d_%s_%d_%I64d_%I64d_%I64u",
+      AccountInfoInteger(ACCOUNT_LOGIN),Symbol(),gMagicCore,ChartID(),
+      (long)TimeLocal(),GetMicrosecondCount());
+   gEntrySignalSequence=0;
+   ArrayResize(gEntryDispatchDiagnostics,0); ArrayResize(gEntryObservedDeals,0);
+   ArrayResize(gEntryCandidateDeals,0);
+   string base="RemoraObjective_EntryDiag_v1_"+gEntryInstanceID;
+   int collision=0;
+   gEntryDiagnosticFile=base+".csv";
+   while(FileIsExist(gEntryDiagnosticFile))
+   {
+      collision++;
+      gEntryDiagnosticFile=base+"_"+(string)collision+".csv";
+   }
+   if(collision>0) gEntryInstanceID+="_"+(string)collision;
+   gEntryDiagnosticHandle=FileOpen(gEntryDiagnosticFile,
+      FILE_READ|FILE_WRITE|FILE_TXT|FILE_ANSI|FILE_SHARE_READ);
+   if(gEntryDiagnosticHandle==INVALID_HANDLE)
+   {
+      Print("[Scalper 1995][ENTRY_DIAGNOSTICS_UNAVAILABLE] Separate diagnostic file could not be opened; financial journals are unchanged.");
+      return false;
+   }
+   EntryDiagnosticHeader(); FileFlush(gEntryDiagnosticHandle);
+   return true;
+}
+
+void EntryDiagnosticsClose()
+{
+   if(gEntryDiagnosticHandle!=INVALID_HANDLE)
+   {
+      FileFlush(gEntryDiagnosticHandle); FileClose(gEntryDiagnosticHandle);
+      gEntryDiagnosticHandle=INVALID_HANDLE;
+   }
+}
+
+void WriteEntryDiagnostic(const ArmedSignal &s,string event,ulong deal=0,
+                         double fillPrice=0,double fillVolume=0,long fillMsc=0,
+                         ulong order=0)
+{
+   if(gEntryDiagnosticHandle==INVALID_HANDLE) return;
+   bool fill=deal>0 && MathIsValidNumber(fillPrice) && fillPrice>0 &&
+      MathIsValidNumber(fillVolume) && fillVolume>0 && fillMsc>0;
+   string clock="TRANSITION";
+   if(event=="DISPATCH_RESULT_BOUND") clock="OBSERVED_AFTER_API_AND_FINANCIAL_COMPLETION";
+   if(event=="FILL_CONFIRMED" && fill) event="DEAL_CONFIRMED";
+   string line="";
+   CsvAdd(line,"OBJECTIVE_ENTRY_1"); CsvAdd(line,event);
+   CsvAdd(line,s.signalID); CsvAdd(line,Symbol()); CsvAdd(line,(string)gMagicCore);
+   CsvAdd(line,s.route); CsvAdd(line,DirStr(s.dir)); CsvAdd(line,s.mode);
+   CsvAdd(line,(string)s.entry.thesisMsc); CsvAdd(line,CsvD(s.entry.signalReferencePrice));
+   CsvAdd(line,CsvD(s.entry.trigger)); CsvAdd(line,(string)s.entry.confirmationMsc);
+   CsvAdd(line,CsvD(s.entry.confirmationPrice)); CsvAdd(line,(string)s.dispatchQuoteMsc);
+   CsvAdd(line,CsvD(s.dispatchAsk)); CsvAdd(line,CsvD(s.dispatchBid));
+   CsvAdd(line,CsvD(s.requestPrice)); CsvAdd(line,order>0?(string)order:"");
+   CsvAdd(line,fill?(string)deal:""); CsvAdd(line,fill?CsvD(fillPrice):"");
+   CsvAdd(line,fill?CsvD(fillVolume):""); CsvAdd(line,fill?(string)fillMsc:"");
+   CsvAdd(line,s.entryReason); CsvAdd(line,CsvTime(s.armedAt));
+   CsvAdd(line,(string)Inp_ArmedTimeoutSec); CsvAdd(line,BStr(s.entry.dispatchAttempted));
+   uint requestID=0;
+   for(int i=0;i<ArraySize(gEntryDispatchDiagnostics);i++)
+      if(gEntryDispatchDiagnostics[i].signal.signalID==s.signalID)
+      { requestID=gEntryDispatchDiagnostics[i].requestID; break; }
+   CsvAdd(line,requestID>0?(string)requestID:"");
+   bool apiResult=event=="DISPATCH_RESULT_BOUND" || event=="REQUEST_ACCEPTED" || event=="ORDER_FAILED";
+   CsvAdd(line,apiResult?(string)trade.ResultRetcode():
+      (StringFind(event,"REQUEST_RESULT_")==0?StringSubstr(event,15):""));
+   CsvAdd(line,s.entry.confirmationMsc>s.entry.thesisMsc?
+      (string)(s.entry.confirmationMsc-s.entry.thesisMsc):"");
+   CsvAdd(line,s.dispatchQuoteMsc>=s.entry.confirmationMsc && s.entry.confirmationMsc>0?
+      (string)(s.dispatchQuoteMsc-s.entry.confirmationMsc):"");
+   CsvAdd(line,fill && fillMsc>=s.dispatchQuoteMsc && s.dispatchQuoteMsc>0?
+      (string)(fillMsc-s.dispatchQuoteMsc):"");
+   CsvAdd(line,clock);
+   if(armed.active && armed.signalID==s.signalID) FARRow(line);
+   else
+   {
+      string header="",columns[]; FARHeader(header);
+      int count=StringSplit(header,',',columns);
+      for(int i=0;i<count;i++) CsvAdd(line,"");
+   }
+   if(event=="DISPATCH_RESULT_BOUND")
+   {
+      // PositionOpen was actually invoked before this original callback. This
+      // retrospective record adds no IO between the durable barrier and send.
+      string attempt=line;
+      StringReplace(attempt,",DISPATCH_RESULT_BOUND,",",SEND_ATTEMPT,");
+      FileWriteString(gEntryDiagnosticHandle,attempt+"\r\n");
+   }
+   FileWriteString(gEntryDiagnosticHandle,line+"\r\n");
+   // Bounded timer flush; no flush per trade or tick.
+}
+
+int RememberEntryDispatch()
+{
+   int n=ArraySize(gEntryDispatchDiagnostics);
+   if(ArrayResize(gEntryDispatchDiagnostics,n+1)!=n+1)
+   {
+      Print("[Scalper 1995][ENTRY_DISPATCH_DIAGNOSTIC_UNAVAILABLE] Could not retain diagnostic correlation; financial request state is unchanged.");
+      return -1;
+   }
+   gEntryDispatchDiagnostics[n].signal=armed;
+   gEntryDispatchDiagnostics[n].orderTicket=0;
+   gEntryDispatchDiagnostics[n].resultDeal=0;
+   gEntryDispatchDiagnostics[n].requestID=0;
+   return n;
+}
+
+bool EntryDealAlreadyObserved(ulong deal)
+{
+   for(int i=0;i<ArraySize(gEntryObservedDeals);i++)
+      if(gEntryObservedDeals[i]==deal) return true;
+   return false;
+}
+
+void EntryObserveDeal(ulong deal)
+{
+   if(deal==0 || EntryDealAlreadyObserved(deal) || !HistoryDealSelect(deal)) return;
+   ResetLastError();
+   string symbol=HistoryDealGetString(deal,DEAL_SYMBOL);
+   long magic=HistoryDealGetInteger(deal,DEAL_MAGIC);
+   long entry=HistoryDealGetInteger(deal,DEAL_ENTRY);
+   long type=HistoryDealGetInteger(deal,DEAL_TYPE);
+   ulong order=(ulong)HistoryDealGetInteger(deal,DEAL_ORDER);
+   double price=HistoryDealGetDouble(deal,DEAL_PRICE);
+   double volume=HistoryDealGetDouble(deal,DEAL_VOLUME);
+   long timeMsc=HistoryDealGetInteger(deal,DEAL_TIME_MSC);
+   if(GetLastError()!=0 || symbol!=Symbol() || magic!=(long)gMagicCore || order==0 ||
+      (entry!=DEAL_ENTRY_IN && entry!=DEAL_ENTRY_INOUT) ||
+      !MathIsValidNumber(price) || price<=0 || !MathIsValidNumber(volume) || volume<=0 || timeMsc<=0)
+      return;
+   int match=-1;
+   for(int i=0;i<ArraySize(gEntryDispatchDiagnostics);i++)
+   {
+      bool exactOrder=gEntryDispatchDiagnostics[i].orderTicket>0 &&
+         gEntryDispatchDiagnostics[i].orderTicket==order;
+      bool exactDeal=gEntryDispatchDiagnostics[i].resultDeal>0 &&
+         gEntryDispatchDiagnostics[i].resultDeal==deal;
+      if(!exactOrder && !exactDeal) continue;
+      int dir=gEntryDispatchDiagnostics[i].signal.dir;
+      if((dir==1 && type!=DEAL_TYPE_BUY) || (dir==-1 && type!=DEAL_TYPE_SELL)) continue;
+      if(match>=0) return; // ambiguous correlation is never guessed
+      match=i;
+   }
+   if(match<0) return; // Pre-restart/unbound history is not fabricated into this run.
+   int count=ArraySize(gEntryObservedDeals);
+   if(ArrayResize(gEntryObservedDeals,count+1)!=count+1) return;
+   gEntryObservedDeals[count]=deal;
+   ArmedSignal snapshot=gEntryDispatchDiagnostics[match].signal;
+   string event=entry==DEAL_ENTRY_IN?"FILL_CONFIRMED":"FILL_INOUT_UNEXPECTED";
+   WriteEntryDiagnostic(snapshot,event,deal,price,volume,timeMsc,order);
+}
+
+void BindEntryDispatch(int idx,ulong order,ulong deal,uint requestID)
+{
+   if(idx<0 || idx>=ArraySize(gEntryDispatchDiagnostics)) return;
+   gEntryDispatchDiagnostics[idx].orderTicket=order;
+   gEntryDispatchDiagnostics[idx].resultDeal=deal;
+   gEntryDispatchDiagnostics[idx].requestID=requestID;
+   WriteEntryDiagnostic(gEntryDispatchDiagnostics[idx].signal,"DISPATCH_RESULT_BOUND",0,0,0,0,order);
+   // Synchronous results can expose a fill before its queued transaction event.
+   // History unavailability here is retried by the real DEAL_ADD event.
+   if(deal>0) EntryObserveDeal(deal);
+   for(int i=0;i<ArraySize(gEntryCandidateDeals);i++)
+      EntryObserveDeal(gEntryCandidateDeals[i]);
+}
+
+void EntryObserveFill(const MqlTradeTransaction &trans)
+{
+   if(trans.type==TRADE_TRANSACTION_DEAL_ADD && trans.deal>0)
+   {
+      // Transaction order is not guaranteed. Buffer only observed own entry
+      // deal IDs, and still require exact order/deal identity before logging.
+      if(HistoryDealSelect(trans.deal))
+      {
+         ResetLastError();
+         string symbol=HistoryDealGetString(trans.deal,DEAL_SYMBOL);
+         long magic=HistoryDealGetInteger(trans.deal,DEAL_MAGIC);
+         long entry=HistoryDealGetInteger(trans.deal,DEAL_ENTRY);
+         if(GetLastError()==0 && symbol==Symbol() && magic==(long)gMagicCore &&
+            (entry==DEAL_ENTRY_IN || entry==DEAL_ENTRY_INOUT))
+         {
+            bool known=false;
+            int n=ArraySize(gEntryCandidateDeals);
+            for(int i=0;i<n;i++)
+               if(gEntryCandidateDeals[i]==trans.deal) { known=true; break; }
+            if(!known && ArrayResize(gEntryCandidateDeals,n+1)==n+1)
+               gEntryCandidateDeals[n]=trans.deal;
+         }
+      }
+      EntryObserveDeal(trans.deal);
+   }
+}
+
+// Call only for TRADE_TRANSACTION_REQUEST, after the original financial
+// transaction processing. A later result may supply the exact order/deal that
+// the synchronous response did not expose. Never infer identity from Magic or
+// a similar price alone, and never bind a request whose ID was unavailable.
+void EntryObserveRequest(const MqlTradeRequest &request,const MqlTradeResult &result)
+{
+   if(result.request_id==0 || request.symbol!=Symbol() ||
+      request.magic!=(ulong)gMagicCore || request.action!=TRADE_ACTION_DEAL ||
+      request.position!=0 || request.position_by!=0) return;
+   int match=-1;
+   for(int i=0;i<ArraySize(gEntryDispatchDiagnostics);i++)
+   {
+      if(gEntryDispatchDiagnostics[i].requestID==0 ||
+         gEntryDispatchDiagnostics[i].requestID!=result.request_id) continue;
+      if(match>=0) return;
+      match=i;
+   }
+   if(match<0) return;
+   ArmedSignal snapshot=gEntryDispatchDiagnostics[match].signal;
+   if(request.comment!="S1995|"+snapshot.route+"|"+snapshot.mode ||
+      (snapshot.dir==1 && request.type!=ORDER_TYPE_BUY) ||
+      (snapshot.dir==-1 && request.type!=ORDER_TYPE_SELL) ||
+      !MathIsValidNumber(request.price) || request.price<=0 ||
+      MathAbs(request.price-snapshot.requestPrice)>gTickSize*0.000001 ||
+      !MathIsValidNumber(request.volume) || request.volume<=0 ||
+      MathAbs(request.volume-snapshot.lots)>AccountingVolumeTolerance()) return;
+   if((result.order>0 && gEntryDispatchDiagnostics[match].orderTicket>0 &&
+       result.order!=gEntryDispatchDiagnostics[match].orderTicket) ||
+      (result.deal>0 && gEntryDispatchDiagnostics[match].resultDeal>0 &&
+       result.deal!=gEntryDispatchDiagnostics[match].resultDeal))
+   {
+      WriteEntryDiagnostic(snapshot,"REQUEST_RESULT_IDENTITY_CONFLICT");
+      return;
+   }
+   if(result.order>0) gEntryDispatchDiagnostics[match].orderTicket=result.order;
+   if(result.deal>0) gEntryDispatchDiagnostics[match].resultDeal=result.deal;
+   WriteEntryDiagnostic(snapshot,"REQUEST_RESULT_"+(string)result.retcode,0,0,0,0,
+      gEntryDispatchDiagnostics[match].orderTicket);
+   if(gEntryDispatchDiagnostics[match].resultDeal>0)
+      EntryObserveDeal(gEntryDispatchDiagnostics[match].resultDeal);
+   for(int i=0;i<ArraySize(gEntryCandidateDeals);i++)
+      EntryObserveDeal(gEntryCandidateDeals[i]);
+}
