+// Restore 1.122 account compatibility. Ownership/conflict checks remain per action;
+// neither Magic nor the local instance lock proves cross-terminal exclusivity.
+bool InitializeAccountMode()
+{
+   gAccountMarginMode=(ENUM_ACCOUNT_MARGIN_MODE)AccountInfoInteger(ACCOUNT_MARGIN_MODE);
+   gNetting=(gAccountMarginMode==ACCOUNT_MARGIN_MODE_RETAIL_NETTING ||
+             gAccountMarginMode==ACCOUNT_MARGIN_MODE_EXCHANGE);
+   gExchange=(gAccountMarginMode==ACCOUNT_MARGIN_MODE_EXCHANGE);
+   switch(gAccountMarginMode)
+   {
+      case ACCOUNT_MARGIN_MODE_RETAIL_HEDGING:
+         Print("[Scalper 1995][ACCOUNT_MODE] RETAIL_HEDGING: supported; own positions require order/history identity, not Magic alone.");
+         return true;
+      case ACCOUNT_MARGIN_MODE_RETAIL_NETTING:
+         Print("[Scalper 1995][ACCOUNT_MODE] RETAIL_NETTING: supported; consolidated-position ownership and conflicts checked by order/history identity; no cross-terminal exclusivity assumed.");
+         return true;
+      case ACCOUNT_MARGIN_MODE_EXCHANGE:
+         Print("[Scalper 1995][ACCOUNT_MODE] EXCHANGE: supported; consolidated-position ownership and conflicts checked by order/history identity; no cross-terminal exclusivity assumed.");
+         return true;
+   }
+   Print("[Scalper 1995][INIT_REJECTED] Unknown ACCOUNT_MARGIN_MODE; no trading or financial recovery started.");
+   return false;
+}
+
+bool OperationalAccountModeSupported()
+{
+   return (gAccountMarginMode==ACCOUNT_MARGIN_MODE_RETAIL_HEDGING ||
+           gAccountMarginMode==ACCOUNT_MARGIN_MODE_RETAIL_NETTING ||
+           gAccountMarginMode==ACCOUNT_MARGIN_MODE_EXCHANGE) &&
+      (ENUM_ACCOUNT_MARGIN_MODE)AccountInfoInteger(ACCOUNT_MARGIN_MODE)==gAccountMarginMode;
+}
+
+int OnInit()
+{
+  if(!InitializeAccountMode()) return INIT_PARAMETERS_INCORRECT;
+  string sym=Symbol();
+  gIsDollarFamily=(StringFind(sym,"WDO")>=0 || StringFind(sym,"DOL")>=0);
+  gIsIndexFamily=!gIsDollarFamily && (StringFind(sym,"WIN")>=0 ||
+StringFind(sym,"IND")>=0);
+  if(!gIsDollarFamily && !gIsIndexFamily)
+  { Print("[Scalper 1995][CONFIG] Unsupported contract symbol: ",sym); return INIT_PARAMETERS_INCORRECT; }
+  gBandMultiplier=gIsIndexFamily?Inp_BandMultiplier_WIN:Inp_BandMultiplier_WDO;
+  gMagicCore=gIsIndexFamily?Inp_Magic_WIN:Inp_Magic_WDO;
+
+gMaxDeviationPts=gIsIndexFamily?Inp_MaxDeviationPts_WIN:Inp_MaxDeviationPts_WDO;
+gSpreadMaxPts=gIsIndexFamily?Inp_SpreadMaxPts_WIN:Inp_SpreadMaxPts_WDO;
+gBreakoutMargin=gIsIndexFamily?Inp_BreakoutMargin_WIN:Inp_BreakoutMargin_WDO;
+gMaxOvershoot=gIsIndexFamily?Inp_MaxOvershoot_WIN:Inp_MaxOvershoot_WDO;
+gSL_Pts=gIsIndexFamily?Inp_SL_Pts_WIN:Inp_SL_Pts_WDO;
+gTP_Pts=gIsIndexFamily?Inp_TP_Pts_WIN:Inp_TP_Pts_WDO;
+
+gABS_MinDisplPts=gIsIndexFamily?Inp_ABS_MinPriceMovePts_WIN:Inp_ABS_MinPriceMovePts_WDO;
+
+gCONT_MinDisplPts=gIsIndexFamily?Inp_CONT_MinPriceMovePts_WIN:Inp_CONT_MinPriceMovePts_WDO;
+  gTickSize=SymbolInfoDouble(Symbol(),SYMBOL_TRADE_TICK_SIZE);
+   // Tick-grid normalization must use the actual trade tick size, never _Point.
+   if(!Positive(gTickSize))
+   { Print("[Scalper 1995][CONFIG] SYMBOL_TRADE_TICK_SIZE unavailable"); return INIT_PARAMETERS_INCORRECT; }
+  if(!Positive(Inp_BandMultiplier_WIN) || !Positive(Inp_BandMultiplier_WDO) ||
+     !Positive(gTickSize) || !Validate1995Inputs())
+  { Print("[SCALPER][FATAL] Invalid Scalper 1995 parameters; no silent correction."); return
+INIT_PARAMETERS_INCORRECT; }
+  if(!IsFokSupported())
+  { Print("[SCALPER][FATAL] FOK unsupported."); return
+INIT_PARAMETERS_INCORRECT; }
+  trade.SetExpertMagicNumber(gMagicCore);
+  trade.SetDeviationInPoints(gMaxDeviationPts);
+  trade.SetTypeFilling(ORDER_FILLING_FOK);
+  trade.SetAsyncMode(false);
+  // Same-version instances in this terminal must not race financial journals.
+  // This is not a cross-terminal or non-cooperating-EA ownership guarantee.
+  string lockName=StringFormat("Scalper1995_%I64d_%s_%d.instance.lock",
+     AccountInfoInteger(ACCOUNT_LOGIN),sym,gMagicCore);
+  gInstanceLock=FileOpen(lockName,FILE_READ|FILE_WRITE|FILE_BIN);
+  if(gInstanceLock==INVALID_HANDLE)
+  { Print("[Scalper 1995][INSTANCE_LOCK_UNAVAILABLE] initialization blocked"); return INIT_FAILED; }
+  MqlDateTime now; TimeToStruct(TimeTradeServer(),now);
+  gDayKey=now.year*1000+now.day_of_year;
+  ResetArmedSignal(); ResetOpenPos();
+  InitializeAccounting();
+  gLastFlushTime=0; eodDone=false; eodStuckLogged=false; eodNextTry=0;
+  RestoreDailyPersistence();
+  BootstrapCachesNoTrade();
+// A configurable label cannot remove the explicit schema namespace.
+string prefix="Scalper1995_";
+if(CSVFileName!="Scalper1995" && CSVFileName!="") prefix+=CSVFileName+"_";
+string suffix=Symbol()+"_"+IntegerToString(gMagicCore);
+gTradeCsvFileName=prefix+suffix+"_Trades.csv";
+EntryDiagnosticsInit(); // session-local stream; originals and financial recovery are untouched
+
+csvTradeHandle=FileOpen(prefix+suffix+"_Trades.csv",FILE_READ|FILE_WRITE|FILE_TXT
+|FILE_ANSI|FILE_SHARE_READ|FILE_SHARE_WRITE);
+  if(csvTradeHandle!=INVALID_HANDLE)
+  {
+     if(FileSize(csvTradeHandle)==0) WriteTradeHeader();
+     FileFlush(csvTradeHandle);
+     if(!InitializeTradeCsvIndex(prefix+suffix+"_Trades.csv"))
+        Print("[SCALPER][TRADES_CSV_INDEX_UNAVAILABLE] Finalization records require CSV reconciliation.");
+     FileSeek(csvTradeHandle,0,SEEK_END);
+  }
+  // One-second analytical catch-up also in tester; financial recovery retains its own throttles.
+  gFinancialTimerDue=TimeTradeServer()+(MQLInfoInteger(MQL_TESTER)!=0?60:1);
+  if(!EventSetTimer(1)) return INIT_FAILED;
+  Print("[Remora Objective] EXPERIMENTAL; native compilation/replay not certified; financial namespace S1995 retained.");
+  PrintFormat("[OBJECTIVE_INPUTS] warmup_sec=%d min_trades=%d min_sigma_ticks=%.8f session_start=%d session_end=%d max_gap_sec=%d baseline_waves=%d reversal_pts=%.8f event_ticks=%d CONT_eff=%.8f ABS_eff=%.8f rejection=%.8f chunk_msc=%d max_records=%d chunks_per_timer=%d sigma_tolerance_ticks=%.12f",
+     Inp_BandsWarmupSec,Inp_BandsMinTrades,Inp_BandsMinSigmaTicks,
+     Inp_RegularSessionStartHHMM,Inp_RegularSessionEndHHMM,Inp_FeedMaxGapSec,
+     Inp_WaveBaselineMin,gIsIndexFamily?Inp_WaveReversalPts_WIN:Inp_WaveReversalPts_WDO,
+     Inp_PathEventTicks,Inp_CONT_MinPathEfficiency,Inp_ABS_MaxPathEfficiency,
+     Inp_ABS_MinRejectionFraction,Inp_DataChunkMsc,Inp_DataMaxChunkTrades,
+     Inp_DataChunksPerTimer,Inp_SigmaCheckToleranceTicks);
+  PrintFormat("[OBJECTIVE_EFFECTIVE] symbol=%s magic=%d context=%s signal=%s k=%.8f abs_volume_ratio=%.8f cont_volume_ratio=%.8f abs_progress=%.8f cont_progress=%.8f trigger_margin=%.8f timeout=%d spread=%.8f overshoot=%.8f deviation=%d SL=%.8f TP_input=%.8f exit=%s FAR=%s FAR_threshold=%.8f",
+     sym,gMagicCore,EnumToString(Inp_ContextTF),EnumToString(Inp_SignalTF),gBandMultiplier,
+     Inp_ABS_Effort,Inp_CONT_Effort,gABS_MinDisplPts,gCONT_MinDisplPts,gBreakoutMargin,
+     Inp_ArmedTimeoutSec,gSpreadMaxPts,gMaxOvershoot,gMaxDeviationPts,gSL_Pts,gTP_Pts,
+     EnumToString(Inp_ExitMode),EnumToString(Inp_AggressionFilterMode),Inp_AggressionThresholdPct);
+  return INIT_SUCCEEDED;
+}
