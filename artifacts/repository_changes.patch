+bool FARPriceValid(double price)
+{
+   return MathIsValidNumber(price) && price>0 && gTickSize>0 &&
+      MathAbs(price/gTickSize-MathRound(price/gTickSize))<=0.000001;
+}
+// Full snapshots are used for a closed context. Rolling updates replace the
+// whole last millisecond before appending, retaining legitimate same-ms trades.
+// There is no deduplication by timestamp and no mixture of real/integer volume.
+bool FARRollingRead(ulong start,ulong endExclusive)
+{
+   if(start>=endExclusive) return false;
+   ulong queryStart=start;
+   int retained=0,n=ArraySize(gFARRollingTicks);
+   if(gFARCacheSequence==armed.farSignalSequence && gFARCacheEndMsc<=endExclusive && n>0)
+   {
+      ulong boundary=(ulong)gFARRollingTicks[n-1].time_msc;
+      if(boundary>=start && boundary<endExclusive)
+      {
+         queryStart=boundary;
+         for(int i=0;i<n;i++)
+            if((ulong)gFARRollingTicks[i].time_msc>=start &&
+               (ulong)gFARRollingTicks[i].time_msc<boundary)
+               retained++;
+      }
+   }
+   MqlTick update[];
+   int copied=CopyTradeTicksStrict(queryStart,endExclusive-1,update);
+   bool trustworthy=copied>=0 && retained+copied<=1000000;
+   for(int i=0;trustworthy && i<copied;i++)
+      if(update[i].time_msc<=0 || (ulong)update[i].time_msc<queryStart ||
+         (ulong)update[i].time_msc>=endExclusive ||
+         (i>0 && update[i].time_msc<update[i-1].time_msc)) trustworthy=false;
+   // Repeated boundary reads may append trades at the same millisecond, but
+   // may not silently remove/reorder/revise any previously observed record.
+   // Compare the entire old boundary prefix, including duplicate multiplicity.
+   if(trustworthy && gFARCacheSequence==armed.farSignalSequence &&
+      gFARCacheEndMsc<=endExclusive && n>0 &&
+      (ulong)gFARRollingTicks[n-1].time_msc==queryStart)
+   {
+      int offset=0;
+      for(int i=0;i<n;i++)
+      {
+         if((ulong)gFARRollingTicks[i].time_msc!=queryStart) continue;
+         if(offset>=copied || update[offset].time_msc!=gFARRollingTicks[i].time_msc ||
+            update[offset].last!=gFARRollingTicks[i].last ||
+            update[offset].volume!=gFARRollingTicks[i].volume ||
+            update[offset].volume_real!=gFARRollingTicks[i].volume_real ||
+            update[offset].flags!=gFARRollingTicks[i].flags)
+         { trustworthy=false; break; }
+         offset++;
+      }
+   }
+   if(!trustworthy) { ArrayResize(gFARRollingTicks,0); gFARCacheEndMsc=0; return false; }
+   int kept=0;
+   for(int i=0;i<n && kept<retained;i++)
+      if((ulong)gFARRollingTicks[i].time_msc>=start &&
+         (ulong)gFARRollingTicks[i].time_msc<queryStart)
+         gFARRollingTicks[kept++]=gFARRollingTicks[i];
+   if(ArrayResize(gFARRollingTicks,retained+copied)!=retained+copied)
+   { ArrayResize(gFARRollingTicks,0); gFARCacheEndMsc=0; return false; }
+   for(int i=0;i<copied;i++) gFARRollingTicks[retained+i]=update[i];
+   gFARCacheEndMsc=endExclusive; gFARCacheSequence=armed.farSignalSequence;
+   return true;
+}
+bool FARBuildWindow(MqlTick &ticks[],ulong start,ulong endExclusive,FARWindow &w)
+{
+   ZeroMemory(w); w.startMsc=start; w.endExclusiveMsc=endExclusive;
+   if(start>=endExclusive) return false;
+   int n=ArraySize(ticks);
+   if(n==0 || n>1000000) return false; // bounded collector; unavailable => no veto
+   bool anyReal=false,anyIntegerOnly=false;
+   ulong previous=0;
+   for(int i=0;i<n;i++)
+   {
+      if(ticks[i].time_msc<=0 || (ulong)ticks[i].time_msc<start ||
+         (ulong)ticks[i].time_msc>=endExclusive ||
+         (i>0 && (ulong)ticks[i].time_msc<previous) ||
+         !FARPriceValid(ticks[i].last) || !MathIsValidNumber(ticks[i].volume_real) ||
+         ticks[i].volume_real<0) return false;
+      previous=(ulong)ticks[i].time_msc;
+      if(ticks[i].volume_real>0) anyReal=true;
+      else if(ticks[i].volume>0) anyIntegerOnly=true;
+      else return false;
+   }
+   if(anyReal && anyIntegerOnly) return false; // source ambiguity: no veto
+   w.realVolume=anyReal;
+   ulong midMsc=start+(endExclusive-start)/2;
+   w.high=-DBL_MAX; w.low=DBL_MAX;
+   for(int i=0;i<n;i++)
+   {
+      double v=w.realVolume?ticks[i].volume_real:(double)ticks[i].volume;
+      bool buy=((ticks[i].flags&TICK_FLAG_BUY)!=0),sell=((ticks[i].flags&TICK_FLAG_SELL)!=0);
+      bool firstHalf=((ulong)ticks[i].time_msc<midMsc);
+      if(buy && !sell)
+      {
+         w.buy+=v;
+         if(firstHalf) { w.firstBuy+=v; w.knownFirstHalf++; }
+         else { w.secondBuy+=v; w.knownSecondHalf++; }
+      }
+      else if(sell && !buy)
+      {
+         w.sell+=v;
+         if(firstHalf) { w.firstSell+=v; w.knownFirstHalf++; }
+         else { w.secondSell+=v; w.knownSecondHalf++; }
+      }
+      else
+      {
+         w.unknown+=v;
+         if(firstHalf) w.firstUnknown+=v; else w.secondUnknown+=v;
+      }
+      if(i==0) { w.first=ticks[i].last; w.firstMsc=(ulong)ticks[i].time_msc; }
+      w.last=ticks[i].last; w.lastMsc=(ulong)ticks[i].time_msc;
+      w.high=MathMax(w.high,ticks[i].last); w.low=MathMin(w.low,ticks[i].last);
+      w.records++;
+   }
+   double total=w.buy+w.sell+w.unknown;
+   w.valid=MathIsValidNumber(total) && total>0;
+   return w.valid;
+}
+bool FARReadContext()
+{
+   MqlTick contextTicks[];
+   if(armed.farContextStartMsc==0 || armed.farContextEndExclusiveMsc<=armed.farContextStartMsc ||
+      armed.farContextEndExclusiveMsc>armed.farArmedMsc) return false;
+   if(CopyTradeTicksStrict(armed.farContextStartMsc,armed.farContextEndExclusiveMsc-1,contextTicks)<0)
+      return false;
+   return FARBuildWindow(contextTicks,armed.farContextStartMsc,armed.farContextEndExclusiveMsc,gFARContext);
+}
+void FARCaptureArm()
+{
+   FARClearEvidence();
+   if(Inp_AggressionFilterMode==FAR_OFF) return;
+   MqlTick tick;
+   if(!SymbolInfoTick(Symbol(),tick) || tick.time_msc<=0) return;
+   gFARSequence++;
+   armed.farSignalSequence=gFARSequence;
+   armed.farSignalBarMsc=(ulong)gCachedMicroBar*1000;
+   armed.farArmedMsc=(ulong)tick.time_msc;
+   // Require a verifiable executed-trade event at capture; a quote-only last
+   // price cannot establish the arm-time trade identity and disables FAR veto.
+   bool tradeEvent=((tick.flags&(TICK_FLAG_LAST|TICK_FLAG_VOLUME|TICK_FLAG_BUY|TICK_FLAG_SELL))!=0);
+   armed.farArmPriceValid=tradeEvent && FARPriceValid(tick.last) &&
+      ((MathIsValidNumber(tick.volume_real) && tick.volume_real>0) || tick.volume>0);
+   armed.farArmPrice=armed.farArmPriceValid?tick.last:0;
+   datetime closed=iTime(Symbol(),Inp_ContextTF,1);
+   armed.farContextStartMsc=(ulong)closed*1000;
+   armed.farContextEndExclusiveMsc=armed.farContextStartMsc+(ulong)PeriodSeconds(Inp_ContextTF)*1000;
+   FARReadContext(); // frozen once per arm; failure is unavailable, never fabricated
+}
+double FARPct(double part,double total)
+{ return total>0?100.0*part/total:0.0; }
+double FAROppositePct(const FARWindow &w,int half)
+{
+   if(half==1) return FARPct(armed.dir==1?w.firstSell:w.firstBuy,w.firstBuy+w.firstSell+w.firstUnknown);
+   if(half==2) return FARPct(armed.dir==1?w.secondSell:w.secondBuy,w.secondBuy+w.secondSell+w.secondUnknown);
+   return FARPct(armed.dir==1?w.sell:w.buy,w.buy+w.sell+w.unknown);
+}
+void FAREvaluate(ulong endExclusive)
+{
+   gFAREvidence=true; gFARWouldCancel=false; gFARCancelled=false;
+   ZeroMemory(gFARCurrent); // invalid evaluations must not retain an older window
+   gFARState=FAR_INDETERMINADO; gFARReason="IDENTITY_OR_CLOCK_UNAVAILABLE";
+   if(!armed.active || !armed.farArmPriceValid || armed.farSignalSequence==0 ||
+      armed.farArmedMsc==0 || endExclusive<=armed.farArmedMsc ||
+      armed.farSignalBarMsc==0 || (armed.dir!=1 && armed.dir!=-1) ||
+      (armed.route!="ABS" && armed.route!="CONT")) return;
+   if(!armed.entry.enabled || !armed.entry.triggerReady ||
+      !FARPriceValid(armed.regionHigh) || !FARPriceValid(armed.regionLow) ||
+      armed.regionHigh<armed.regionLow)
+   { gFARReason="FAR_STRUCTURE_UNAVAILABLE"; return; }
+   ulong span=(ulong)PeriodSeconds(Inp_SignalTF)*1000;
+   if(span==0 || endExclusive<=span) return;
+   ulong start=endExclusive-span;
+   gFARReason="TICK_HISTORY_UNAVAILABLE";
+   if(!FARRollingRead(start,endExclusive) ||
+      !FARBuildWindow(gFARRollingTicks,start,endExclusive,gFARCurrent)) return;
+   double threshold=armed.route=="ABS"?gABS_MinDisplPts:gCONT_MinDisplPts;
+   double adverseFromArm=-armed.dir*(gFARCurrent.last-armed.farArmPrice);
+   double adverseInWindow=-armed.dir*(gFARCurrent.last-gFARCurrent.first);
+   bool structure=armed.dir==1?gFARCurrent.last<=armed.regionLow-gTickSize:
+      gFARCurrent.last>=armed.regionHigh+gTickSize;
+   // Strictly after arm: an event at the arm millisecond is not evidence
+   // of a later contradiction; both temporal halves must sustain pressure.
+   bool posterior=(start>armed.farArmedMsc && gFARCurrent.firstMsc>armed.farArmedMsc);
+   bool sustained=(gFARCurrent.knownFirstHalf>0 && gFARCurrent.knownSecondHalf>0 &&
+      FAROppositePct(gFARCurrent,0)>=Inp_AggressionThresholdPct &&
+      FAROppositePct(gFARCurrent,1)>=Inp_AggressionThresholdPct &&
+      FAROppositePct(gFARCurrent,2)>=Inp_AggressionThresholdPct);
+   if(posterior && sustained && adverseFromArm>=threshold && adverseInWindow>=threshold && structure)
+   {
+      gFARState=FAR_CONTRADICAO; gFARReason="POST_ARM_FULL_HALVES_PRESSURE_DISPLACEMENT_STRUCTURE";
+      gFARWouldCancel=true; return;
+   }
+   gFARState=FAR_NEUTRO;
+   gFARReason=posterior?"VETO_PREDICATES_NOT_ALL_PROVEN":"NO_COMPLETE_POST_ARM_WINDOW";
+   double directional=armed.dir*(gFARCurrent.last-gFARCurrent.first);
+   double supportPct=FARPct(armed.dir==1?gFARCurrent.buy:gFARCurrent.sell,
+      gFARCurrent.buy+gFARCurrent.sell+gFARCurrent.unknown);
+   double trigger=armed.entry.trigger;
+   bool originalBreakout=armed.dir==1?gFARCurrent.last>=trigger:gFARCurrent.last<=trigger;
+   if(armed.route=="CONT" && supportPct>=Inp_AggressionThresholdPct &&
+      directional>=gCONT_MinDisplPts && originalBreakout)
+   {
+      gFARState=FAR_FAVORAVEL; gFARReason="CONT_PRESSURE_PROGRESS_ORIGINAL_BREAKOUT";
+   }
+   if(armed.route=="ABS" && gFARContext.valid && posterior &&
+      gFARContext.endExclusiveMsc<=armed.farArmedMsc &&
+      FAROppositePct(gFARContext,0)>=Inp_AggressionThresholdPct)
+   {
+      double testExcursion=armed.dir==1?gFARContext.first-gFARContext.low:
+         gFARContext.high-gFARContext.first;
+      double reaction=armed.dir*(gFARCurrent.last-armed.farArmPrice);
+      if(testExcursion<gABS_MinDisplPts && directional>=gABS_MinDisplPts && reaction>=gABS_MinDisplPts)
+      {
+         gFARState=FAR_FAVORAVEL; gFARReason="ABS_CONTEXT_STALL_SEPARATE_POST_ARM_REACTION";
+      }
+   }
+}
+bool FARBeforeDecision()
+{
+   if(Inp_AggressionFilterMode==FAR_OFF || !armed.active) return false;
+   // No experimental cancellation while any preparation/dispatch/proof is
+   // unresolved. The original financial protocol retains exclusive ownership.
+   if(gAccountingUnresolved || HasExecutionInFlight() || HasOpenPosition()) return false;
+   MqlTick tick;
+   if(!SymbolInfoTick(Symbol(),tick) || tick.time_msc<=0) return false;
+   ulong now=(ulong)tick.time_msc;
+   if(now!=gFARLastDecisionMsc)
+   {
+      ulong begin=GetMicrosecondCount();
+      FAREvaluate(now); gFARLastDecisionMsc=now;
+      gFARLastUs=GetMicrosecondCount()-begin; gFARCalls++;
+      gFARSumUs+=gFARLastUs; if(gFARLastUs>gFARMaxUs) gFARMaxUs=gFARLastUs;
+   }
+   bool cancel=Inp_AggressionFilterMode==FAR_APLICAR && gFARState==FAR_CONTRADICAO;
+   gFARCancelled=cancel;
+   string eventKey=(string)gFARState+"|"+gFARReason;
+   if(eventKey!=gFARLastEvent || cancel)
+   {
+      gFARLastEvent=eventKey;
+      WriteAuditRow(cancel?"FAR_CANCEL":(gFARWouldCancel?"FAR_WOULD_CANCEL":"FAR_STATE"),
+         DirStr(armed.dir),armed.mode,gFARCurrent.last,armed.posRel,armed.distD1,armed.effort,
+         ArmedTriggerPrice());
+   }
+   if(cancel) { ResetArmedSignal(); return true; }
+   return false;
+}
+void FARHeader(string &line)
+{
+   string names="FAR_SCHEMA,FAR_MODE,FAR_THRESHOLD_PCT,FAR_STATE,FAR_REASON,FAR_SIGNAL_SEQUENCE,FAR_SIGNAL_BAR_MSC,FAR_ARM_MSC,FAR_EVAL_MSC,FAR_AGE_MSC,FAR_ARM_PRICE,FAR_CONTEXT_START,FAR_CONTEXT_END_EXCLUSIVE,FAR_CURRENT_START,FAR_CURRENT_END_EXCLUSIVE,FAR_CONTEXT_BUY_PCT,FAR_CONTEXT_SELL_PCT,FAR_CONTEXT_UNKNOWN,FAR_BUY_PCT,FAR_SELL_PCT,FAR_UNKNOWN,FAR_VOLUME_SOURCE,FAR_FIRST,FAR_LAST,FAR_HIGH,FAR_LOW,FAR_NET,FAR_ADVERSE_EXCURSION,FAR_FAVORABLE_EXCURSION,FAR_ADVERSE_FROM_ARM,FAR_ADVERSE_IN_WINDOW,FAR_OPPOSITE_PCT_HALF1,FAR_OPPOSITE_PCT_HALF2,FAR_KNOWN_HALF1,FAR_KNOWN_HALF2,FAR_WOULD_CANCEL,FAR_CANCELLED,FAR_LAST_US,FAR_CALLS,FAR_TOTAL_US,FAR_MAX_US";
+   string columns[]; int count=StringSplit(names,',',columns);
+   for(int i=0;i<count;i++) CsvAdd(line,columns[i]);
+}
+void FARRow(string &line)
+{
+   CsvAdd(line,"FAR1995_1"); CsvAdd(line,EnumToString(Inp_AggressionFilterMode));
+   CsvAdd(line,CsvD(Inp_AggressionThresholdPct));
+   CsvAdd(line,gFAREvidence?EnumToString(gFARState):"");
+   CsvAdd(line,gFAREvidence?gFARReason:"");
+   CsvAdd(line,(string)armed.farSignalSequence); CsvAdd(line,(string)armed.farSignalBarMsc);
+   CsvAdd(line,(string)armed.farArmedMsc); CsvAdd(line,(string)gFARLastDecisionMsc);
+   CsvAdd(line,gFARLastDecisionMsc>=armed.farArmedMsc?(string)(gFARLastDecisionMsc-armed.farArmedMsc):"");
+   CsvAdd(line,armed.farArmPriceValid?CsvD(armed.farArmPrice):"");
+   CsvAdd(line,(string)armed.farContextStartMsc); CsvAdd(line,(string)armed.farContextEndExclusiveMsc);
+   CsvAdd(line,(string)gFARCurrent.startMsc); CsvAdd(line,(string)gFARCurrent.endExclusiveMsc);
+   double ct=gFARContext.buy+gFARContext.sell+gFARContext.unknown;
+   double nt=gFARCurrent.buy+gFARCurrent.sell+gFARCurrent.unknown;
+   CsvAdd(line,gFARContext.valid?CsvD(FARPct(gFARContext.buy,ct)):"");
+   CsvAdd(line,gFARContext.valid?CsvD(FARPct(gFARContext.sell,ct)):"");
+   CsvAdd(line,gFARContext.valid?CsvD(gFARContext.unknown):"");
+   CsvAdd(line,gFARCurrent.valid?CsvD(FARPct(gFARCurrent.buy,nt)):"");
+   CsvAdd(line,gFARCurrent.valid?CsvD(FARPct(gFARCurrent.sell,nt)):"");
+   CsvAdd(line,gFARCurrent.valid?CsvD(gFARCurrent.unknown):"");
+   CsvAdd(line,gFARCurrent.valid?(gFARCurrent.realVolume?"VOLUME_REAL":"VOLUME_INTEGER"):"");
+   CsvAdd(line,gFARCurrent.valid?CsvD(gFARCurrent.first):"");
+   CsvAdd(line,gFARCurrent.valid?CsvD(gFARCurrent.last):"");
+   CsvAdd(line,gFARCurrent.valid?CsvD(gFARCurrent.high):"");
+   CsvAdd(line,gFARCurrent.valid?CsvD(gFARCurrent.low):"");
+   CsvAdd(line,gFARCurrent.valid?CsvD(gFARCurrent.last-gFARCurrent.first):"");
+   double adverse=armed.dir==1?gFARCurrent.first-gFARCurrent.low:gFARCurrent.high-gFARCurrent.first;
+   double favorable=armed.dir==1?gFARCurrent.high-gFARCurrent.first:gFARCurrent.first-gFARCurrent.low;
+   CsvAdd(line,gFARCurrent.valid?CsvD(adverse):"");
+   CsvAdd(line,gFARCurrent.valid?CsvD(favorable):"");
+   CsvAdd(line,gFARCurrent.valid && armed.farArmPriceValid?CsvD(-armed.dir*(gFARCurrent.last-armed.farArmPrice)):"");
+   CsvAdd(line,gFARCurrent.valid?CsvD(-armed.dir*(gFARCurrent.last-gFARCurrent.first)):"");
+   CsvAdd(line,gFARCurrent.valid?CsvD(FAROppositePct(gFARCurrent,1)):"");
+   CsvAdd(line,gFARCurrent.valid?CsvD(FAROppositePct(gFARCurrent,2)):"");
+   CsvAdd(line,(string)gFARCurrent.knownFirstHalf); CsvAdd(line,(string)gFARCurrent.knownSecondHalf);
+   CsvAdd(line,BStr(gFARWouldCancel)); CsvAdd(line,BStr(gFARCancelled));
+   CsvAdd(line,(string)gFARLastUs); CsvAdd(line,(string)gFARCalls);
+   CsvAdd(line,(string)gFARSumUs); CsvAdd(line,(string)gFARMaxUs);
+}
