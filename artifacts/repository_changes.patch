+def block_end(mask, opening):
+    depth = 1
+    position = opening + 1
+    while position < len(mask) and depth:
+        depth += (mask[position] == "{") - (mask[position] == "}")
+        position += 1
+    if depth:
+        raise ValueError("Unterminated source block")
+    return position
